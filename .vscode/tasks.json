{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current Indent File",
      "type": "shell",
      "command": "indent",
      "args": [
        "${file}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Lint Current Indent File",
      "type": "shell",
      "command": "indent",
      "args": [
        "lint",
        "${file}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Check Current Indent File",
      "type": "shell",
