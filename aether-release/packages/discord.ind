#! PERMISSIONS BITMASK SYSTEM (5.0)
#! ==============================
var PermCreateInvite int = 1
var PermKick int = 2
var PermBan int = 4
var PermAdmin int = 8
var PermManageChannels int = 16
var PermManageGuild int = 32
var PermAddReactions int = 64
var PermViewAuditLog int = 128
var PermPrioritySpeaker int = 256
var PermStream int = 512
var PermViewChannel int = 1024
var PermSendMessages int = 2048
var PermSendTts int = 4096
var PermManageMessages int = 8192
var PermEmbedLinks int = 16384
var PermAttachFiles int = 32768
var PermReadHistory int = 65536
var PermMentionEveryone int = 131072
var PermExternalEmojis int = 262144
var PermViewGuildInsights int = 524288
var PermConnect int = 1048576
var PermSpeak int = 2097152
var PermMute int = 4194304
var PermDeafen int = 8388608
var PermMove int = 16777216
var PermUseVad int = 33554432
var PermChangeNick int = 67108864
var PermManageNicks int = 134217728
var PermManageRoles int = 268435456
var PermManageWebhooks int = 536870912
var PermManageEmojis int = 1073741824
var PermUseSlash int = 2147483648
var PermRequestToSpeak int = 4294967296
var PermManageEvents int = 8589934592
var PermManageThreads int = 17179869184
var PermCreatePublicThreads int = 34359738368
var PermCreatePrivateThreads int = 68719476736
var PermExternalStickers int = 137438953472
var PermSendMessagesInThreads int = 274877906944
var PermStartEmbeddedActivities int = 549755813888
var PermModerateMembers int = 1099511627776
var PermAll int = 2251799813685247

fun PermHas
    mask
    perm
    #! For power-of-2 permissions: check if (mask % (perm*2)) >= perm
    var double float = perm * 2
    var mod float = mask % double
    if mod >= perm
        give 1
    give 0

fun PermsOf
    names
    var mask int = 0
    repeat name in names
        var added int = 0
        if name == "CreateInvite"
            mask is mask + PermCreateInvite
        or name == "Kick"
            mask is mask + PermKick
        or name == "Ban"
            mask is mask + PermBan
        or name == "Admin"
            mask is mask + PermAdmin
        or name == "ManageChannels"
            mask is mask + PermManageChannels
        or name == "ManageGuild"
            mask is mask + PermManageGuild
        or name == "AddReactions"
            mask is mask + PermAddReactions
        or name == "ViewChannel"
            mask is mask + PermViewChannel
        or name == "SendMessages"
            mask is mask + PermSendMessages
        or name == "ManageMessages"
            mask is mask + PermManageMessages
        or name == "EmbedLinks"
            mask is mask + PermEmbedLinks
        or name == "AttachFiles"
            mask is mask + PermAttachFiles
        or name == "ReadHistory"
            mask is mask + PermReadHistory
        or name == "MentionEveryone"
            mask is mask + PermMentionEveryone
        or name == "Connect"
            mask is mask + PermConnect
        or name == "Speak"
            mask is mask + PermSpeak
        or name == "Mute"
            mask is mask + PermMute
        or name == "Deafen"
            mask is mask + PermDeafen
        or name == "Move"
            mask is mask + PermMove
        or name == "ManageRoles"
            mask is mask + PermManageRoles
        or name == "ManageWebhooks"
            mask is mask + PermManageWebhooks
        or name == "UseSlash"
            mask is mask + PermUseSlash
        or name == "ModerateMembers"
            mask is mask + PermModerateMembers
    give mask

#! ==============================
#! PAGINATORS (5.0)
#! ==============================
fun Paginator
    pages
    firstLabel
    prevLabel
    nextLabel
    lastLabel
    give {"_pages": pages, "_page": 0, "_first": firstLabel, "_prev": prevLabel, "_next": nextLabel, "_last": lastLabel}

fun PaginatorCurrent
    paginator
    var idx int = paginator._page
    var pages dynamic = paginator._pages
    give pages[idx]

fun PaginatorPage
    paginator
    delta
    var idx int = paginator._page + delta
    var pages dynamic = paginator._pages
    if idx < 0
        idx is 0
    if idx >= len(pages)
        idx is len(pages) - 1
    paginator._page is idx
    give pages[idx]

fun PaginatorButtons
    paginator
    var first dynamic = Button 2 paginator._first "pag_first"
    var prev dynamic = Button 2 paginator._prev "pag_prev"
    var next dynamic = Button 2 paginator._next "pag_next"
    var last dynamic = Button 2 paginator._last "pag_last"
    var row dynamic = ActionRow first prev next last
    give row

#! ==============================
#! ENHANCED CACHE (5.0)
#! ==============================
var _GUILD_CACHE dynamic = {}
var _CHANNEL_CACHE dynamic = {}
var _ROLE_CACHE dynamic = {}

fun CacheGuild
    guild
    if has_key guild "id"
        _GUILD_CACHE[guild.id] is guild

fun GetCachedGuild
    guildId
    if has_key _GUILD_CACHE guildId
        give _GUILD_CACHE[guildId]
    give empty

fun CacheChannel
    channel
    if has_key channel "id"
        _CHANNEL_CACHE[channel.id] is channel

fun GetCachedChannel
    channelId
    if has_key _CHANNEL_CACHE channelId
        give _CHANNEL_CACHE[channelId]
    give empty

fun CacheRole
    guildId
    role
    var key string = guildId + ":" + role.id
    _ROLE_CACHE[key] is role

fun GetCachedRole
    guildId
    roleId
    var key string = guildId + ":" + roleId
    if has_key _ROLE_CACHE key
        give _ROLE_CACHE[key]
    give empty

fun ResolveUser
    guildId
    raw
    var uid string = ConvertUserId raw
    if uid == empty
        give empty
    give {"id": uid, "mention": "<@" + uid + ">"}

#! �📋  AUDIT / MONITORING (3.0)
#! ==============================
#! SetupAudit registers handlers for every monitoring event and posts a
#! summary embed to the given channel. Call once during setup:
#!   bot is SetupAudit bot "123456789012345678"
var _AUDIT_CHANNEL string = ""
var _AUDIT_ENABLED int = 0

fun AuditPost
    bot
    title
    desc
    color
    if _AUDIT_ENABLED == 0
        give empty
    var emb dynamic = BuildEmbed title desc color
    give SendEmbed bot.token _AUDIT_CHANNEL emb

fun AuditAuthor
    data
    var author string = "?"
    if has_key data "author"
        if has_key data.author "username"
            author is data.author.username
    give author

fun AuditChannelId
    data
    var chan string = "?"
    if has_key data "channel_id"
        chan is data.channel_id
    give chan

fun AuditContent
    data
    var content string = ""
    if has_key data "content"
        content is data.content
    give content

fun AuditUserName
    data
    var user string = "?"
