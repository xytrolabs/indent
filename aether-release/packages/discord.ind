#! =============================================================================
#! discord.ind 6.0 — The Indent Discord bot library
#! =============================================================================
#!
#! A standalone Discord library (like discord.py): REST API, WebSocket Gateway,
#! command routing, event system, puzzle/cog loader, a discord.py-style `ctx`
#! system, clean block-style helpers, and a built-in audit/monitoring suite.
#! Import it and write your bot.
#!
#! 🆕 v6.0 adds: Real Bot API (Bot, Command, Ready, Message, Interaction,
#! MemberJoin, MemberLeave, Start, Audit) — production-grade, minimal boilerplate.
#! Also: voice gateway, file attachments, 36-flag permissions, paginators,
#! enhanced cache, auto-complete, ResolveUser, cooldowns, and more.
#!
#! NOTE: the native Indent runtime passes function arguments by value, so every
#! function that modifies the bot RETURNS the modified bot. Always reassign:
#!   bot is addCmd bot "kick" kickCmd ["user"]
#!   bot is LoadPuzzles bot "puzzles"
#!
#! 🚀 3-line bot:
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   Run bot
#!
#! ⚡ With commands:
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   AddCommand bot "ping" "Check latency" handler
#!   On bot "ready" readyHandler
#!   Run bot
#!
#! 🔒 Permission checks (new in 4.0):
#!   get AddCheck, HasRole from discord
#!   bot is AddCheck bot "kick" "OnlyMods"
#!   bot is AddCheck bot "ban" "OnlyAdmins"
#!   fun OnlyMods bot src cmd args
#!       give HasRole src "" "MOD_ROLE_ID"
#!
#! 📋 Audit log:
#!   get QuickBot, SetupAudit from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   bot is SetupAudit bot "123456789012345678"   # <- channel id for logs
#!   Run bot
#!
#! 🧭 discord.py-style ctx:
#!   get CtxSend from discord
#!   fun greet ctx args
#!       CtxSend ctx "Hello!"
#!   bot is BotHandler bot "greet" "Greet people" "greet"
#!
#! 📖 Full reference: docs/discord-package.md
#! =============================================================================

#! ---- constants ----
var API string = "https://discord.com/api/v10"
var GatewayURL string = "wss://gateway.discord.gg/?v=10&encoding=json"

#! discord package version
var DiscordVersion string = "6.0.0"

#! Current source/context for the clean block API (module-level, shared).
#! The native runtime passes args by value, so we stash the "current source"
#! here so sendMsg/kick/ban/etc. can reply without needing bot._ctx to mutate.
var _CTX dynamic = {}

#! Current gateway socket id (module-level, shared) — used by presence helpers.
var _SOCKET int = 0

#! Lightweight in-memory message cache (keyed by message id) so MESSAGE_DELETE
#! / MESSAGE_UPDATE handlers can see the last-known message content.
var _MSG_CACHE dynamic = {}

fun CacheMessage
    msg
    if has_key msg "id"
        var mid string = msg.id
        _MSG_CACHE[mid] is msg

fun LookupMessage
    mid
    if has_key _MSG_CACHE mid
        give _MSG_CACHE[mid]
    give empty

fun ClearMessageCache
    _MSG_CACHE is {}

#! ==============================
#! 🔌  REST API (low level)
#! ==============================

fun Get
    path
    token
    var url string = API + path
    var auth string = "Bot " + token
    give http_get url auth

#! ==============================
#! ⚡  PARALLEL REST (6.5) — fetch many resources concurrently
#! ==============================
#! Fetch multiple items in parallel via the `parallel` gather builtin.
#! NOTE: spawn/parallel can only run functions DEFINED IN THE MAIN SCRIPT
#! (not module functions). Pass a worker function you define in bot.ind:
#!   fun myGet path token
#!       give Get path token
#!   var results dynamic = ParallelFetch "myGet" token paths
#! Returns a list of results in the same order as the paths.
fun ParallelFetch
    workerName
    token
    paths
    var arglists dynamic = []
    repeat p in paths
        var pair dynamic = [p, token]
        arglists is arglists + [pair]
    give parallel workerName arglists

fun Post
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_post_json url body auth

fun Put
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_put_json url body auth

fun Patch
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_patch_json url body auth

fun Delete
    path
    token
    var url string = API + path
    var auth string = "Bot " + token
    give http_delete url auth

#! ==============================
#! 📎  FILE ATTACHMENTS (5.0)
#! ==============================
#! Send a file as a message attachment using multipart/form-data.
#! The runtime's http_post_multipart sends {content, file_name, file_data}.
#!   var file dynamic = BuildFile "image.png" fileBytes
#!   PostFile bot.token channelId "Look!" file

fun BuildFile
    filename
    filedata
    give {"filename": filename, "data": filedata}

#! Read a file into a multipart body. Returns the file data as a string.
#! Usage:  var f dynamic = ReadFile "path/to/image.png"
fun ReadFile
    filePath
    give file_read filePath

fun PostFile
    token
    channelId
    content
    file
    var path string = "/channels/" + channelId + "/messages"
    give http_post_multipart path token content file

fun SendFile
    token
    channelId
    content
    filePath
    var f dynamic = ReadFile filePath
    var file dynamic = BuildFile filePath f
    give PostFile token channelId content file

#! ---- message actions ----
fun Send
    token
    channelId
    content
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content}

fun Reply
    token
    channelId
    messageId
    content
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content, "message_reference": {"message_id": messageId}}

fun SendEmbed
    token
    channelId
    embed
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"embeds": [embed]}

fun MakeEmbed
    title
    description
    color
    give {"title": title, "description": description, "color": color}

fun Edit
    token
    channelId
    messageId
    content
    var path string = "/channels/" + channelId + "/messages/" + messageId
    give Patch path token {"content": content}

fun DeleteMsg
    token
    channelId
    messageId
    var path string = "/channels/" + channelId + "/messages/" + messageId
    give Delete path token

fun React
    token
    channelId
    messageId
    emoji
    var path string = "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    give Put path token {}

fun SendDM
    token
    userId
    content
    var ch dynamic = Post "/users/@me/channels" token {"recipient_id": userId}
    give Send token ch.id content

#! ---- moderation ----
fun Kick
    token
    guildId
    userId
    reason
    var url string = "/guilds/" + guildId + "/members/" + userId
    give Delete url token {"reason": reason}

fun Ban
    token
    guildId
    userId
    reason
    var url string = "/guilds/" + guildId + "/bans/" + userId
    give Put url token {"reason": reason}

fun Unban
    token
    guildId
    userId
    var url string = "/guilds/" + guildId + "/bans/" + userId
    give Delete url token {}

fun Timeout
    token
    guildId
    userId
    seconds
    var url string = "/guilds/" + guildId + "/members/" + userId
    var until float = time_now + seconds
    give Patch url token {"communication_disabled_until": until}

fun AddRole
    token
    guildId
    userId
    roleId
    var url string = "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId
    give Put url token {}

fun RemoveRole
    token
    guildId
    userId
    roleId
    var url string = "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId
    give Delete url token {}

#! ---- guild & user info ----
fun GetUser
    token
    userId
    var url string = "/users/" + userId
    give Get url token

fun GetGuild
    token
    guildId
    var url string = "/guilds/" + guildId
    give Get url token

fun GetChannel
    token
    channelId
    var url string = "/channels/" + channelId
    give Get url token

#! ---- gateway ----
fun WsConnect
    give ws_connect GatewayURL

fun WsSend
    socketId
    payload
    give ws_send_text socketId payload

fun WsRecv
    socketId
    give ws_recv_text socketId

fun WsRecvTimeout
    socketId
    secs
    give ws_recv_text_timeout socketId secs

fun WsClose
    socketId
    give ws_close socketId

#! ==============================
#! 🔊  VOICE GATEWAY (5.0) — voice channel connect, audio, disconnect
#! ==============================
#! Voice uses a separate WebSocket connection. The flow:
#!   1. ConnectVoice bot guildId channelId  →  receives voice state + server
#!   2. VoicePlay bot path                  →  sends audio
#!   3. VoiceStop bot                       →  stops playback
#!   4. DisconnectVoice bot                 →  leaves the channel
var _VOICE_SOCKET int = 0
var _VOICE_GUILD string = ""
var _VOICE_CHANNEL string = ""
var _VOICE_ENDPOINT string = ""
var _VOICE_TOKEN_STR string = ""
var _VOICE_SESSION string = ""
var _VOICE_SERVER_ID string = ""
var _VOICE_USER_ID string = ""
var _VOICE_PLAYING int = 0

#! Connect to a voice channel. Sends the voice state update and waits
#! for the VOICE_SERVER_UPDATE event via the main gateway. Once the
#! voice server info arrives, opens a UDP voice WebSocket.
#! Returns the voice socket ID or 0 on timeout.
fun ConnectVoice
    bot
    guildId
    channelId
    _VOICE_GUILD is guildId
    _VOICE_CHANNEL is channelId
    if has_key bot "user"
        if has_key bot.user "id"
            _VOICE_USER_ID is bot.user.id

    #! Send voice state update (op 4) via the main gateway
    var vsu dynamic = {"op": 4, "d": {"guild_id": guildId, "channel_id": channelId, "self_mute": false, "self_deaf": false}}
    var vsuStr string = json_dumps vsu
    WsSend _SOCKET vsuStr
    say "   🎤 Requesting voice connection to channel " + channelId + "..."

    #! Wait up to 15 seconds for VOICE_SERVER_UPDATE (op 0 t=VOICE_SERVER_UPDATE)
    var waited int = 0
    repeat
        if _VOICE_ENDPOINT != empty and _VOICE_TOKEN_STR != empty
            #! We have server info — open the voice WebSocket
            var vConn dynamic = ws_connect "wss://" + _VOICE_ENDPOINT + "/?v=4"
            _VOICE_SOCKET is vConn.socket_id
            #! Send voice identify
            var vid dynamic = {"op": 0, "d": {"server_id": _VOICE_SERVER_ID, "user_id": _VOICE_USER_ID, "session_id": _VOICE_SESSION, "token": _VOICE_TOKEN_STR}}
            var vidStr string = json_dumps vid
            WsSend _VOICE_SOCKET vidStr
            #! Send select protocol (UDP)
            var vsp dynamic = {"op": 1, "d": {"protocol": "udp", "data": {"address": "0.0.0.0", "port": 0, "mode": "xsalsa20_poly1305"}}}
            var vspStr string = json_dumps vsp
            WsSend _VOICE_SOCKET vspStr
            say "   🎤 Voice connected!"
            give _VOICE_SOCKET
        if waited > 15
            say "   ⚠️ Voice connection timed out"
            give 0
        time_sleep 1
        waited is waited + 1

#! Send a play tone (silence/beep) over the voice connection.
#! For now, sends a speaking indicator (op 5).
fun VoiceStartSpeaking
    bot
    var speak dynamic = {"op": 5, "d": {"speaking": 1, "delay": 0, "ssrc": 1}}
    var speakStr string = json_dumps speak
    WsSend _VOICE_SOCKET speakStr
    _VOICE_PLAYING is 1
    give bot

fun VoiceStopSpeaking
    bot
    var silence dynamic = {"op": 5, "d": {"speaking": 0, "delay": 0, "ssrc": 1}}
    var silStr string = json_dumps silence
    WsSend _VOICE_SOCKET silStr
    _VOICE_PLAYING is 0
    give bot

#! Leave the current voice channel.
fun DisconnectVoice
    bot
    if _VOICE_SOCKET != 0
        WsClose _VOICE_SOCKET
        _VOICE_SOCKET is 0
    if _VOICE_GUILD != empty
        var leave dynamic = {"op": 4, "d": {"guild_id": _VOICE_GUILD, "channel_id": empty, "self_mute": false, "self_deaf": false}}
        var leaveStr string = json_dumps leave
        WsSend _SOCKET leaveStr
    _VOICE_ENDPOINT is ""
    _VOICE_TOKEN_STR is ""
    _VOICE_SESSION is ""
    _VOICE_SERVER_ID is ""
    say "   🎤 Disconnected from voice"
    give bot

#! Capture VOICE_STATE_UPDATE to get session_id, and VOICE_SERVER_UPDATE
#! to get endpoint+token. Called from the main gateway dispatch.
fun OnVoiceStateUpdate
    bot
    data
    _x
    if has_key data "session_id"
        _VOICE_SESSION is data.session_id

fun OnVoiceServerUpdate
    bot
    data
    _x
    if has_key data "endpoint"
        _VOICE_ENDPOINT is data.endpoint
    if has_key data "token"
        _VOICE_TOKEN_STR is data.token
    if has_key data "guild_id"
        _VOICE_SERVER_ID is data.guild_id

#! ==============================
#! 🤖  BOT ENGINE (mid level)
#! ==============================

#! Default gateway intents: broad but NON-privileged (avoids 4014 on bots
#! without GUILD_MEMBERS/GUILD_PRESENCES whitelisted in the Developer Portal).
#! Set bot.intents to override, e.g. bot.intents is 33281 for a minimal bot.
#! 1+4+8+16+32+64+512+1024+2048+4096+8192+32768+65536 = 114301
var DEFAULT_INTENTS int = 114301

fun Identify
    token
    socketId
    intents
    var payload dynamic = {"op": 2, "d": {"token": token, "intents": intents, "properties": {"os": "linux", "browser": "indent", "device": "indent"}}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

fun SetPresence
    token
    status
    activityName
    activityType
    var act dynamic = empty
    if activityName != empty
        act is {"name": activityName, "type": activityType}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": status, "afk": false}}

fun HandleDispatch
    bot
    token
    event
    var t string = event.t
    var d dynamic = event.d

    if t == "READY"
        bot.user is d.user
        say "✅ Logged in as: " + d.user.username
        CallEvent bot "ready" d

    or t == "MESSAGE_CREATE"
        CacheMessage d
        HandleMessage bot token d

    or t == "MESSAGE_UPDATE"
        CacheMessage d
        CallEvent bot "message_edit" d

    or t == "MESSAGE_DELETE"
        var delMsg dynamic = LookupMessage d.id
        if delMsg != empty
            CallEvent bot "message_delete" delMsg
        otherwise
            CallEvent bot "message_delete" d

    or t == "MESSAGE_DELETE_BULK"
        CallEvent bot "message_bulk_delete" d

    or t == "CHANNEL_PIN_UPDATE"
        CallEvent bot "pin_update" d

    or t == "MESSAGE_REACTION_ADD"
        CallEvent bot "reaction_add" d

    or t == "MESSAGE_REACTION_REMOVE"
        CallEvent bot "reaction_remove" d

    or t == "MESSAGE_REACTION_REMOVE_ALL"
        CallEvent bot "reaction_remove_all" d

    or t == "MESSAGE_REACTION_REMOVE_EMOJI"
        CallEvent bot "reaction_remove_emoji" d

    or t == "GUILD_BAN_ADD"
        CallEvent bot "ban_add" d

    or t == "GUILD_BAN_REMOVE"
        CallEvent bot "ban_remove" d

    or t == "GUILD_MEMBER_UPDATE"
        CallEvent bot "member_update" d

    or t == "VOICE_STATE_UPDATE"
        CallEvent bot "voice_state_update" d

    or t == "GUILD_UPDATE"
        CallEvent bot "guild_update" d

    or t == "CHANNEL_CREATE"
        CallEvent bot "channel_create" d

    or t == "CHANNEL_UPDATE"
        CallEvent bot "channel_update" d

    or t == "CHANNEL_DELETE"
        CallEvent bot "channel_delete" d

    or t == "INTERACTION_CREATE"
        HandleInteraction bot token d

    or t == "GUILD_CREATE"
        CallEvent bot "guild_join" d

    or t == "GUILD_MEMBER_ADD"
        CallEvent bot "member_join" d

    or t == "GUILD_MEMBER_REMOVE"
        CallEvent bot "member_leave" d

fun HandleMessage
    bot
    token
    msg
    #! skip own messages
    if has_key msg "author"
        if msg.author != empty
            if has_key msg.author "id"
                if has_key bot "user"
                    if bot.user != empty
                        if has_key bot.user "id"
                            if msg.author.id == bot.user.id
                                give empty

    var content string = ""
    if has_key msg "content"
        content is msg.content

    var prefix string = ""
    if has_key bot "prefix"
        prefix is bot.prefix

    #! check prefix and dispatch command
    if prefix != empty and prefix != ""
        if len(content) >= len(prefix)
            if content[:len(prefix)] == prefix
                var rest string = content[len(prefix):]
                var parts dynamic = split rest " "
                var cmd string = parts[0]
                #! args are passed as a list (parts[1:])
                var args dynamic = []
                if len(parts) > 1
                    args is parts[1:]
                do:
                    RunCommand bot token msg cmd args
                catch as err:
                    var errMsg string = "❌ Error: " + err
                    ReplyTo token msg errMsg
                give empty

    #! call user message handler (errors don't crash the bot)
    do:
        CallEvent bot "message" msg
    catch as err:
        give empty

fun HandleInteraction
    bot
    token
    interaction
    var cmdData dynamic = empty
    if has_key interaction "data"
        cmdData is interaction.data
    if cmdData == empty
        Acknowledge token interaction
        give empty

    var hasName int = 0
    var hasCustom int = 0
    if has_key cmdData "name"
        hasName is 1
    if has_key cmdData "custom_id"
        hasCustom is 1

    #! ---- dispatch ALL custom_id interactions (buttons, menus) to user code ----
    if hasCustom
        do:
            CallEvent bot "interaction" interaction
        catch as err:
            say "   ⚠️ interaction handler error: " + err
        give empty

    #! ---- unknown interactions (no name, no custom_id) — just acknowledge ----
    if not hasName
        Acknowledge token interaction
        give empty

    #! ---- slash commands ----
    var name string = cmdData.name
    var opts dynamic = {}
    if has_key cmdData "options"
        var args dynamic = cmdData.options
        if args != empty
            repeat item in args
                if has_key item "name"
                    var itemName string = item.name
                    if has_key item "value"
                        opts[itemName] is item.value
    Acknowledge token interaction
    RunCommand bot token interaction name opts

fun HandleAutocomplete
    bot
    token
    interaction
    var hasData int = 0
    if has_key interaction "data"
        hasData is 1
    if hasData == 0
        give empty
    var d dynamic = interaction.data
    var hasName int = 0
    if has_key d "name"
        hasName is 1
    if hasName == 0
        give empty
    var cmdName string = d.name
    var hasOpts int = 0
    if has_key d "options"
        hasOpts is 1
    if hasOpts == 0
        give empty
    var autoKey string = "auto_" + cmdName
    if has_key bot "_autocomplete"
        var ac dynamic = bot._autocomplete
        if has_key ac autoKey
            var handler string = ac[autoKey]
            call_func handler bot interaction
    give empty

fun RegisterAutocomplete
    bot
    cmdName
    handlerName
    var ac dynamic = {}
    if has_key bot "_autocomplete"
        ac is bot._autocomplete
    var autoKey string = "auto_" + cmdName
    ac[autoKey] is handlerName
    bot._autocomplete is ac
    give bot

fun Acknowledge
    token
    interaction

    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 5}

fun InteractionReply
    token
    interaction
    content
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"content": content}}

#! Send an ephemeral (user-only) reply to an interaction
fun InteractionEphemeral
    token
    interaction
    content
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"content": content, "flags": 64}}

#! Defer an interaction (show loading, then send followup later)
fun InteractionDefer
    token
    interaction
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 5}

#! Edit the original interaction response (followup via webhook)
fun InteractionEdit
    token
    interaction
    content
    var path string = "/webhooks/" + interaction.application_id + "/" + interaction.token + "/messages/@original"
    Patch path token {"content": content}

fun InteractionEmbed
    token
    interaction
    embed
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"embeds": [embed]}}

#! ==============================
#! ⚡  ASYNC LAYER (6.5) — non-blocking handlers on real OS threads
#! ==============================
#! Indent 1.5.0 runs `spawn`ed functions on background threads, so slow work
#! (AI, REST, webhooks) no longer freezes the gateway event loop.
#!
#! Deferred interaction pattern (respects Discord's 3s window):
#!   DeferReply token interaction        # acknowledge immediately (loading)
#!   SpawnCommand "myHandler" ctx        # run work on a thread
#!   # myHandler finishes with CtxFollowup ctx result  (sent via webhook)

#! Defer an interaction immediately (type 5). Call first so Discord doesn't
#! expire the 3s interaction token, then do slow work and follow up later.
fun DeferReply
    token
    interaction
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    give Post path token {"type": 5}

#! Spawn a command handler on a background thread. Does NOT block the gateway.
#! Returns a task id (for task_done/task_wait). Handler runs as:
#!   fun myHandler ctx args   →  finish with CtxFollowup ctx result
fun SpawnCommand
    handlerName
    ctx
    give spawn handlerName ctx

#! Spawn a named function with up to 2 args on a thread; returns the task id.
fun SpawnTask
    fnName
    arg1
    arg2
    give spawn fnName arg1 arg2

#! Wait for a spawned task and return its result (blocks this caller only).
fun AsyncAwait
    taskId
    give task_wait taskId

#! Is a spawned task finished? Returns 1 if done, 0 if still running.
fun AsyncDone
    taskId
    give task_done taskId

#! Register a command whose handler runs on a background thread (non-blocking).
#!   bot is AsyncCommand bot "analyze" "Run analysis" "onAnalyze"
#! The handler must finish with CtxFollowup (defer happens automatically).
fun AsyncCommand
    bot
    name
    desc
    handlerName
    bot is BotHandler bot name desc handlerName
    bot is AddSlash bot name desc handlerName empty
    #! mark as async so RunCommand spawns it instead of blocking
    var cmds dynamic = bot.commands
    var entry dynamic = cmds[name]
    entry["async"] is 1
    cmds[name] is entry
    bot.commands is cmds
    give bot

#! ==============================
#! 🚀  RunCommand
#! ==============================
fun RunCommand
    bot
    token
    source
    cmd
    args
    #! remember the current source so clean-block helpers can reply
    _CTX is source

    #! built-in: ping (measures REST latency)
    if cmd == "ping"
        var start float = time_perf_counter
        var pingUrl string = API + "/users/@me"
        var pingAuth string = "Bot " + token
        http_get pingUrl pingAuth
        var end float = time_perf_counter
        var ms float = (end - start) * 1000.0
        var pingMsg string = "Pong! (" + string(ms) + "ms)"
        ReplyTo token source pingMsg
        give empty

    #! built-in: help (lists commands)
    or cmd == "help"
        var cmds string = ""
        var cmdKeys dynamic = keys bot.commands
        repeat k in cmdKeys
            if cmds != empty
                cmds is cmds + ", "
            cmds is cmds + "`" + k + "`"
        var helpMsg string = "Commands: " + cmds
        ReplyTo token source helpMsg
        give empty

    #! unknown command
    var knownCmd int = 0
    if has_key bot.commands cmd
        knownCmd is 1
    if not knownCmd
        var unknownMsg string = "Unknown: `" + cmd + "`"
        ReplyTo token source unknownMsg
        give empty

    var command dynamic = bot.commands[cmd]

    #! ----- 4.0: run global checks first -----
    if has_key bot "_globalChecks"
        repeat checkFn in bot._globalChecks
            do:
                var checkErr string = call_func checkFn bot source cmd args
                if checkErr != empty and checkErr != ""
                    ReplyTo token source checkErr
                    give empty
            catch as err:
                ReplyTo token source "⚠️ Check error"
                give empty

    #! ----- 4.0: run per-command checks -----
    if has_key bot "_checks"
        var chkStore dynamic = bot._checks
        if has_key chkStore cmd
            var chkFn string = chkStore[cmd]
            do:
                var chkErr string = call_func chkFn bot source cmd args
                if chkErr != empty and chkErr != ""
                    ReplyTo token source chkErr
                    give empty
            catch as err:
                ReplyTo token source "⚠️ Check error"
                give empty

    #! ----- 4.0: cooldown check -----
    var cdMsg string = CheckCooldown bot source cmd
    if cdMsg != empty and cdMsg != ""
        ReplyTo token source cdMsg
        give empty

    #! 1) simple reply command (from puzzles or SimpleCommand)
    if has_key command "reply"
        var reply dynamic = command.reply
        if reply != empty
            ReplyTo token source reply
            give empty

    #! 2) handler_name command (ctx API / BotHandler) — dispatch via "command" event
    if has_key command "handler_name"
        var handlerName dynamic = command.handler_name
        if handlerName != empty
            #! async command: defer the interaction (if any) and spawn the
            #! handler on a thread so the gateway never blocks on slow work.
            var isAsync int = 0
            if has_key command "async"
                isAsync is 1
            if isAsync == 1
                #! acknowledge/defer first (satisfies the 3s interaction window)
                if has_key source "author"
                    if has_key source "id"
                        var deferPath string = "/interactions/" + source.id + "/" + source.token + "/callback"
                        do:
                            Post token deferPath {"type": 5}
                        catch as err:
                            say "   (defer skipped: " + string(err) + ")"
                spawn handlerName {"cmd": cmd, "token": token, "source": source, "args": args, "handler_name": handlerName}
                give empty
            CallEvent bot "command" {"cmd": cmd, "token": token, "source": source, "args": args, "handler_name": handlerName}
            give empty

    #! 3) handler command (function reference, from add/addCmd) — dict-style args
    if has_key command "handler"
        var handlerFunc dynamic = command.handler

        #! build dict args {"1": ..., "2": ...} from the raw list
        var dictArgs dynamic = {"1": empty, "2": empty, "3": empty, "4": empty, "5": empty, "6": empty, "7": empty, "8": empty, "9": empty}
        var idx int = 1
        repeat item in args
            dictArgs[string(idx)] is item
            idx is idx + 1

        #! auto-validate required args if registered with addCmd
        if has_key command "args"
            var argNames dynamic = command.args
            var j int = 1
            repeat expected in argNames
                var key string = string(j)
                var val dynamic = dictArgs[key]
                if val == empty or val == ""
                    var errMsg string = "❌ Missing argument " + key + ": " + expected
                    ReplyTo token source errMsg
                    give empty
                j is j + 1

        #! ----- 4.0: custom error handler -----
        do:
            call_func handlerFunc dictArgs
        catch as err:
            var handled int = 0
            if has_key bot "_errorHandler"
                var errH dynamic = bot._errorHandler
                if errH != empty and errH != ""
                    var src2 dynamic = source
                    var cmdErrMsg string = "❌ Command error: " + err
                    src2["error"] is cmdErrMsg
                    call_func errH bot src2 cmd
                    handled is 1
            if handled == 0
                var cmdErrMsg string = "❌ Command error: " + err
                ReplyTo token source cmdErrMsg
        give empty

    ReplyTo token source "Command has no action"

fun ReplyTo
    token
    source
    content
    if has_key source "author"
        if source.author != empty
            Reply token source.channel_id source.id content
            give empty
    #! interaction source
    InteractionReply token source content

fun CallEvent
    bot
    event
    args
    var handlers dynamic = bot.handlers
    var keysList dynamic = keys handlers
    var found string = ""
    repeat k in keysList
        if k == event
            found is handlers[k]
    if found != empty and found != ""
        call_func found bot args ""

#! ==============================
#! ⏳  WAIT_FOR (4.0) — wait for the next occurrence of an event
#! ==============================
#! Wait for a specific gateway event within a timeout. Used inside commands:
#!   get WaitFor from discord
#!   var resp dynamic = WaitFor bot "message" 30
#!   if resp != empty: CtxSend ctx "Got: " + resp.content
#! Internally sets a one-shot handler that stores the event data in
#! bot._awaited[event] and returns it to the caller.
var _WAIT_TARGET string = ""
var _WAIT_DATA dynamic = empty

#! Start waiting for an event. Returns the bot dict.
fun WaitForStart
    bot
    event
    bot._waitEvent is event
    bot._waitData is empty
    bot._waitDone is 0
    #! register a temporary handler that captures the next event payload
    var tmpHandler string = "_wait_capture"
    bot is On bot event tmpHandler
    give bot

#! Internal — called by connectOnce when the awaited event fires.
fun _wait_capture
    bot
    data
    _x
    bot._waitData is data
    bot._waitDone is 1

#! Poll until the event arrives or timeout expires (non-blocking poll).
#! Call from inside a command handler after WaitForStart.
fun WaitForPoll
    bot
    timeout
    var start float = time_now
    repeat
        if has_key bot "_waitDone"
            if bot._waitDone == 1
                bot._waitDone is 0
                give bot._waitData
        if time_now - start >= timeout
            give empty
        time_sleep 0.2

#! ==============================
#! 🎯  QUICKBOT API (high level)
#! ==============================

#! Create a bot — one function call
fun QuickBot
    token
    prefix
    give {"token": token, "prefix": prefix, "commands": {}, "handlers": {}, "user": {}, "_socketId": 0, "_checks": {}, "_cooldowns": {}, "_tasks": [], "_globalChecks": [], "_userCommands": {}, "_messageCommands": {}, "_waitData": empty, "_waitDone": 0}

#! Add a prefix command (handler = function reference — limited support)
#! Returns bot — reassign:  bot is AddCommand bot "name" "desc" handler
fun AddCommand
    bot
    name
    description
    handler
    var _cmds4 dynamic = bot.commands
    _cmds4[name] is {"description": description, "handler": handler}
    bot.commands is _cmds4
    give bot

#! Add a handler-based command (handler_name = string function name)
#! The handler is dispatched through the "command" event with a ctx object:
#!   fun myHandler ctx args
#!       CtxSend ctx "Hello!"
#! Returns bot — reassign:  bot is BotHandler bot "name" "desc" "handlerName"
fun BotHandler
    bot
    name
    desc
    handlerName
    var _cmds5 dynamic = bot.commands
    _cmds5[name] is {"description": desc, "handler_name": handlerName}
    bot.commands is _cmds5
    give bot

#! Add an event handler (handler is a string function name or a callable)
#! Returns bot — reassign:  bot is On bot "ready" "onReady"
fun On
    bot
    event
    handler
    var _handlers2 dynamic = bot.handlers
    _handlers2[event] is handler
    bot.handlers is _handlers2
    give bot

#! ==============================
#! ==============================
#! 🤖  BOT API (6.0) — Production-grade bot system
#! ==============================
#! Create a real Discord bot with minimal boilerplate. Production-ready:
#! built-in ping, help, error handling, audit logging, health checks.
#!
#!   get Bot, Command, Ready, Start from discord
#!
#!   var bot dynamic = Bot "TOKEN" "!"
#!
#!   Command bot "ping" "Check latency" "onPing"
#!   Ready bot "onReady"
#!
#!   fun onPing ctx
#!       CtxSend ctx "Pong!"
#!
#!   fun onReady bot
#!       say "Bot is online!"
#!
#!   Start bot

fun Bot
    token
    prefix
    var bot dynamic = QuickBot token prefix
    #! Built-in commands
    bot is BotHandler bot "ping" "Check bot latency" "_bot_ping"
    bot is BotHandler bot "help" "List all commands" "_bot_help"
    #! Built-in error handler
    bot is SetErrorHandler bot "_bot_error"
    #! Health tracking
    bot._started is time_now
    bot._reconnects is 0
    bot._lastHb is time_now
    give bot

fun _bot_ping
    ctx
    args
    var s float = time_perf_counter
    http_get (API + "/users/@me") ("Bot " + ctx.token)
    var ms float = (time_perf_counter - s) * 1000.0
    CtxSend ctx ("Pong! Gateway: `" + string(ms) + "ms`")

fun _bot_help
    ctx
    args
    var cmds dynamic = {}
    if has_key ctx "_bot"
        cmds is ctx._bot.commands
    var msg string = "**Commands:**\n"
    var keysList dynamic = keys cmds
    repeat k in keysList
        var entry dynamic = cmds[k]
        var desc string = ""
        if has_key entry "description"
            desc is entry.description
        var line string = "`" + k + "` - " + desc + "\n"
        msg is msg + line
    CtxSend ctx msg

fun _bot_error
    bot
    source
    cmd
    var err string = ""
    var hasE int = 0
    if has_key source "error"
        hasE is 1
    if hasE == 1
        err is source.error
    var msg string = "Command `" + cmd + "` failed"
    if err != empty
        msg is msg + ": " + err
    CtxSend source msg

#! Register a prefix+slash command with a ctx-based handler.
#!   Command bot "greet" "Greet someone" "onGreet"
#!   fun onGreet ctx
#!       CtxSend ctx "Hello " + CtxUserName ctx
fun Command
    bot
    name
    desc
    handlerName
    bot is BotHandler bot name desc handlerName
    bot is AddSlash bot name desc handlerName empty
    give bot

#! Register a READY event handler. Handler receives (bot).
#!   Ready bot "onReady"
#!   fun onReady bot
#!       say "Bot online as " + bot.user.username
fun Ready
    bot
    handlerName
    bot is On bot "ready" handlerName
    give bot

#! Register a MESSAGE event handler. Handler receives (bot, msg).
#!   Message bot "onMsg"
#!   fun onMsg bot msg
#!       CtxSend msg "Hello!"
fun Message
    bot
    handlerName
    bot is On bot "message" handlerName
    give bot

#! Register an INTERACTION event handler.
#!   Interaction bot "onBtn"
#!   fun onBtn bot interaction
#!       CtxSend interaction "Clicked!"
fun Interaction
    bot
    handlerName
    bot is On bot "interaction" handlerName
    give bot

#! Register a member-join handler.
fun MemberJoin
    bot
    handlerName
    bot is On bot "member_join" handlerName
    give bot

#! Register a member-leave handler.
fun MemberLeave
    bot
    handlerName
    bot is On bot "member_leave" handlerName
    give bot

#! Start the bot: sync slash commands, connect gateway, run forever.
#! Handles auto-reconnect, health logging.
fun Start
    bot
    say "Starting bot..."
    SyncSlash bot
    say "Slash commands synced. Connecting to Discord..."
    Run bot

#! Register an audit-log channel. Posts monitoring events as embeds.
#!   Audit bot "123456789012345678"
fun Audit
    bot
    channelId
    give SetupAudit bot channelId


#! ==============================
#! �  COMMAND CHECKS / PERMISSIONS (4.0)
#! ==============================
#! Checks gate command execution. Register with AddCheck:
#!   bot is AddCheck bot "kick" "IsModerator"
#! The check function receives (bot, source, cmd, args) and must return ""
#! on success or an error string. If a string is returned, it's sent as the
#! error reply and the command is NOT executed.
#!   fun IsModerator bot source cmd args
#!       var roles dynamic = source.member.roles   (when available)
#!       if <user has mod role>: give ""
#!       give "❌ You need Moderator permissions."

#! Register a check function for a specific command.
#! Returns bot — reassign:  bot is AddCheck bot "kick" "IsModerator"
fun AddCheck
    bot
    cmdName
    checkFnName
    var checksStore dynamic = {}
    if has_key bot "_checks"
        checksStore is bot._checks
    checksStore[cmdName] is checkFnName
    bot._checks is checksStore
    give bot

#! Register a global check (runs for ALL commands).
#! Returns bot — reassign:  bot is AddGlobalCheck bot "IsOwner"
fun AddGlobalCheck
    bot
    checkFnName
    var gcs dynamic = []
    if has_key bot "_globalChecks"
        gcs is bot._globalChecks
    append gcs checkFnName
    bot._globalChecks is gcs
    give bot

#! Built-in: check that the user has at least one of the given role IDs.
#! Usage:  bot is AddCheck bot "kick" "IsModerator"
#! Then define the handler in your bot:
#!   fun IsModerator bot source cmd args
#!       get HasRole from discord
#!       give HasRole source empty "MOD_ROLE_ID" "ADMIN_ROLE_ID"
fun HasRole
    source
    _xtra
    roleId1
    roleId2
    roleId3
    var hasM int = 0
    if has_key source "member"
        hasM is 1
    if hasM == 0
        give "❌ This command requires a guild."
    var member dynamic = source.member
    var hasR int = 0
    if has_key member "roles"
        hasR is 1
    if hasR == 0
        give "❌ Cannot read your roles."
    var roles dynamic = member.roles
    var passed int = 0
    repeat r in roles
        if r == roleId1
            passed is 1
        if roleId2 != empty and r == roleId2
            passed is 1
        if roleId3 != empty and r == roleId3
            passed is 1
    if passed == 1
        give ""
    give "❌ You don't have permission to use this command."

#! Built-in: owner-only check. Compares user.id to bot.ownerId.
#!   bot.ownerId is "1234567890"
#!   bot is AddCheck bot "shutdown" "IsOwnerCheck"
fun IsOwnerCheck
    bot
    source
    cmd
    args
    var hasO int = 0
    if has_key bot "ownerId"
        hasO is 1
    if hasO == 0
        give "❌ Owner ID not configured."
    var hasA int = 0
    if has_key source "author"
        hasA is 1
    if hasA == 0
        give "❌ Cannot check permissions."
    var author dynamic = source.author
    var uid string = ""
    if has_key author "id"
        uid is author.id
    if uid == bot.ownerId
        give ""
    give "❌ Only the bot owner can use this command."

#! ==============================
#! ⚡  COMMAND ERROR HANDLER (4.0)
#! ==============================
#! Set a custom error handler that fires when a command raises an error.
#!   bot is SetErrorHandler bot "onCmdError"
#!   fun onCmdError bot cmd err
#!       CtxSend err.ctx "❌ " + err.message
fun SetErrorHandler
    bot
    handlerName
    bot._errorHandler is handlerName
    give bot

#! ==============================
#! ⏱️  COOLDOWNS (4.0)
#! ==============================
#! per-command cooldown tracking: {cmdName: {userId: lastUsedTimestamp}}
var _COOLDOWNS dynamic = {}

#! Set a cooldown (seconds) on a command. 0 = no cooldown.
#! Returns bot — reassign:  bot is SetCooldown bot "kick" 30
fun SetCooldown
    bot
    cmdName
    seconds
    var cds dynamic = {}
    if has_key bot "_cooldowns"
        cds is bot._cooldowns
    cds[cmdName] is seconds
    bot._cooldowns is cds
    give bot

#! Check+enforce cooldown. Returns "" if OK, or an error message if on cooldown.
#! Called automatically by RunCommand before executing a handler.
fun CheckCooldown
    bot
    source
    cmd
    var cds dynamic = {}
    if has_key bot "_cooldowns"
        cds is bot._cooldowns
    var hasCd int = 0
    if has_key cds cmd
        hasCd is 1
    if hasCd == 0
        give ""
    var cdSeconds dynamic = cds[cmd]
    var now float = time_now

    var uid string = "anon"
    if has_key source "author"
        if has_key source.author "id"
            uid is source.author.id

    var key string = cmd + "_" + uid
    if has_key _COOLDOWNS key
        var last float = _COOLDOWNS[key]
        if now - last < cdSeconds
            var remain float = cdSeconds - (now - last)
            give "⏱️ Cooldown: " + string(remain) + "s remaining."
    _COOLDOWNS[key] is now
    give ""

#! ==============================
#! 🔄  CONVERTERS (4.0)
#! ==============================
#! Convert a raw arg string like "<@123>" or "123" into a clean ID.
#! Returns the ID string or empty on failure.
fun ConvertUserId
    raw
    if raw == empty
        give empty
    var id string = raw
    #! strip <@...> / <@!...> mention syntax
    if starts_with id "<@"
        id is replace id "<@" ""
        if starts_with id "!"
            id is replace id "!" ""
        if ends_with id ">"
            id is replace id ">" ""
    give id

fun ConvertRoleId
    raw
    if raw == empty
        give empty
    var id string = raw
    if starts_with id "<@&"
        id is replace id "<@&" ""
        if ends_with id ">"
            id is replace id ">" ""
    give id

fun ConvertChannelId
    raw
    if raw == empty
        give empty
    var id string = raw
    if starts_with id "<#"
        id is replace id "<#" ""
        if ends_with id ">"
            id is replace id ">" ""
    give id

#! ==============================
#! 🪟  MODALS (4.0)
#! ==============================
#! Build a modal dict ready to send as an interaction response.
#!   var modal dynamic = BuildModal "custom_modal" "My Title"
#!   AddModalField modal "name" "Your Name" "short" 1 "e.g. Ada"
#!   SendModal token interaction modal
fun BuildModal
    customId
    title
    give {"title": title, "custom_id": customId, "components": []}

fun AddModalField
    modal
    fieldId
    label
    styleName
    required
    placeholder
    var st int = styleInt styleName
    var row dynamic = {"type": 1, "components": [{"type": 4, "custom_id": fieldId, "label": label, "style": st, "required": required}]}
    if placeholder != empty
        var compList dynamic = row.components
        var inp dynamic = compList[0]
        inp["placeholder"] is placeholder
    var comps dynamic = modal.components
    append comps row
    modal.components is comps
    give modal

#! "short" → 1, "paragraph" → 2
fun styleInt
    styleName
    if styleName == "paragraph"
        give 2
    give 1

#! Send a modal as an interaction response (type 9)
fun SendModal
    token
    interaction
    modal
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 9, "data": modal}

#! Extract modal field values from a modal submit interaction.
#! Returns a dict of {custom_id: value}
fun ModalValues
    interaction
    var vals dynamic = {}
    var hasData int = 0
    if has_key interaction "data"
        hasData is 1
    if hasData == 0
        give vals
    var d dynamic = interaction.data
    var hasComps int = 0
    if has_key d "components"
        hasComps is 1
    if hasComps == 0
        give vals
    repeat row in d.components
        if has_key row "components"
            repeat comp in row.components
                if has_key comp "custom_id"
                    var mid string = comp.custom_id
                    var val string = ""
                    if has_key comp "value"
                        val is comp.value
                    vals[mid] is val
    give vals

