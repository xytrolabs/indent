#! Register all monitoring handlers → audit-log embeds to channelId.
#! Returns bot — reassign:  bot is SetupAudit bot "channelId"
fun SetupAudit
    bot
    channelId
    _AUDIT_ENABLED is 1
    _AUDIT_CHANNEL is channelId
    bot is On bot "message_edit" "AuditMessageEdit"
    bot is On bot "message_delete" "AuditMessageDelete"
    bot is On bot "message_bulk_delete" "AuditMessageBulkDelete"
    bot is On bot "pin_update" "AuditPin"
    bot is On bot "reaction_add" "AuditReactionAdd"
    bot is On bot "reaction_remove" "AuditReactionRemove"
    bot is On bot "reaction_remove_all" "AuditReactionRemoveAll"
    bot is On bot "ban_add" "AuditBan"
    bot is On bot "ban_remove" "AuditUnban"
    bot is On bot "member_join" "AuditMemberJoin"
    bot is On bot "member_leave" "AuditMemberLeave"
    bot is On bot "member_update" "AuditMemberUpdate"
    bot is On bot "voice_state_update" "AuditVoice"
    bot is On bot "channel_create" "AuditChannelCreate"
    bot is On bot "channel_update" "AuditChannelUpdate"
    bot is On bot "channel_delete" "AuditChannelDelete"
    give bot

#! One full connect + event-loop cycle. Returns "reconnect" or "fatal".
fun connectOnce
    bot
    var conn dynamic = ws_connect GatewayURL
    var socketId int = conn.socket_id
    var infoResp dynamic = WsRecvTimeout socketId 10
    if infoResp.ok != true
        give "reconnect"
    var infoText string = infoResp.text
    var info dynamic = json_loads infoText
    bot._socketId is socketId
    _SOCKET is socketId

    var heartbeatInterval float = 0
    if has_key info "d"
        if has_key info.d "heartbeat_interval"
            heartbeatInterval is info.d.heartbeat_interval / 1000.0

    #! identify — broad non-privileged intents, overridable via bot.intents
    var intents int = DEFAULT_INTENTS
    if has_key bot "intents"
        intents is bot.intents
    var identify dynamic = {"op": 2, "d": {"token": bot.token, "intents": intents, "properties": {"os": "linux", "browser": "indent", "device": "indent"}}}
    var identifyStr string = json_dumps identify
    WsSend socketId identifyStr

    var lastHb float = time_now
    var seq int = 0

    say "🤖 Bot running — press Ctrl+C to stop"
    repeat
        #! short receive timeout so we can check heartbeat timing frequently
        var resp dynamic = WsRecvTimeout socketId 5

        #! send heartbeat if due (checked after every wakeup)
        if heartbeatInterval > 0
            var now float = time_now
            if now - lastHb >= heartbeatInterval
                var hb dynamic = {"op": 1, "d": seq}
                var hbStr string = json_dumps hb
                WsSend socketId hbStr
                lastHb is now

        #! gateway closed the connection
        if has_key resp "closed"
            say "📡 Gateway closed connection"
            WsClose socketId
            give "reconnect"

        #! timeout — heartbeat check above already handled timing
        if has_key resp "timeout"
            next
        if resp.ok != true
            next

        var raw string = resp.text
        if raw == empty
            next
        var event dynamic = json_loads raw
        var op int = event.op
        if has_key event "s"
            seq is event.s

        if op == 0
            do:
                var t string = event.t
                var d dynamic = event.d

                if t == "READY"
                    bot.user is d.user
                    say "✅ Logged in: " + d.user.username
                    CallEvent bot "ready" d

                or t == "MESSAGE_CREATE"
                    CacheMessage d
                    HandleMessage bot bot.token d

                or t == "MESSAGE_UPDATE"
                    CacheMessage d
                    CallEvent bot "message_edit" d

                or t == "MESSAGE_DELETE"
                    var delMsg dynamic = LookupMessage d.id
                    if delMsg != empty
                        CallEvent bot "message_delete" delMsg
                    otherwise
                        CallEvent bot "message_delete" d

                or t == "MESSAGE_DELETE_BULK"
                    CallEvent bot "message_bulk_delete" d

                or t == "CHANNEL_PIN_UPDATE"
                    CallEvent bot "pin_update" d

                or t == "MESSAGE_REACTION_ADD"
                    CallEvent bot "reaction_add" d

                or t == "MESSAGE_REACTION_REMOVE"
                    CallEvent bot "reaction_remove" d

                or t == "MESSAGE_REACTION_REMOVE_ALL"
                    CallEvent bot "reaction_remove_all" d

                or t == "MESSAGE_REACTION_REMOVE_EMOJI"
                    CallEvent bot "reaction_remove_emoji" d

                or t == "GUILD_BAN_ADD"
                    CallEvent bot "ban_add" d

                or t == "GUILD_BAN_REMOVE"
                    CallEvent bot "ban_remove" d

                or t == "GUILD_MEMBER_UPDATE"
                    CallEvent bot "member_update" d

                or t == "VOICE_STATE_UPDATE"
                    CallEvent bot "voice_state_update" d

                or t == "GUILD_UPDATE"
                    CallEvent bot "guild_update" d

                or t == "CHANNEL_CREATE"
                    CallEvent bot "channel_create" d

                or t == "CHANNEL_UPDATE"
                    CallEvent bot "channel_update" d

                or t == "CHANNEL_DELETE"
                    CallEvent bot "channel_delete" d

                or t == "INTERACTION_CREATE"
                    HandleInteraction bot bot.token d

                or t == "GUILD_CREATE"
                    CallEvent bot "guild_join" d

                or t == "GUILD_MEMBER_ADD"
                    CallEvent bot "member_join" d

                or t == "GUILD_MEMBER_REMOVE"
                    CallEvent bot "member_leave" d

            catch as err:
                say "   ⚠️ Event error (non-fatal): " + err

        or op == 1
            #! Discord requested a heartbeat — reply and reset the timer
            var hb dynamic = {"op": 1, "d": seq}
            var hbStr string = json_dumps hb
            WsSend socketId hbStr
            lastHb is time_now

        or op == 7
            say "🔄 Gateway requested reconnect"
            WsClose socketId
            give "reconnect"

        or op == 9
            #! d=true: session invalid but resumable; d=false: fatal (bad token)
            var resumable int = 0
            if has_key event "d"
                if event.d == true
                    resumable is 1
            if not resumable
                say "❌ Invalid session — check DISCORD_TOKEN"
                WsClose socketId
                give "fatal"
            say "🔄 Reconnecting session..."
            WsClose socketId
            give "reconnect"

        or op == 10
            #! hello — set heartbeat interval and send initial heartbeat
            if has_key event "d"
                if has_key event.d "heartbeat_interval"
                    heartbeatInterval is event.d.heartbeat_interval / 1000.0
            var initHb dynamic = {"op": 1, "d": seq}
            var initHbStr string = json_dumps initHb
            WsSend socketId initHbStr
            lastHb is time_now

#! Start the bot — connects, and reconnects automatically if dropped
fun Run
    bot
    say "🤖 Connecting to Discord..."
    var attempts int = 0
    repeat
        attempts is attempts + 1
        var status string = "reconnect"
        do:
            status is connectOnce bot
        catch as err:
            say "   ⚠️ Connection error: " + err
            status is "reconnect"
        if status == "fatal"
            say "❌ Fatal error — stopping. Fix DISCORD_TOKEN and re-run."
            stop
        say "🔄 Reconnecting in 5s... (attempt " + string(attempts) + ")"
        time_sleep 5

#! ==============================
#! 🧩  PUZZLE SYSTEM (cog-like command groups)
#! ==============================
#!
#! Puzzles are like Discord.py cogs — each file in puzzles/ is a
#! self-contained module with its own commands and handlers.
#!
#! One-line format (name, desc, reply — all quoted strings):
#!   command "ping" "Check bot latency" "🏓 Pong!"
#!
#! Multi-line format:
#!   command "greet" "Say hello"
#!   reply "Hello there! 👋"

#! Load all puzzles from a directory (.ind files — legacy .ath also accepted).
#! Returns bot — reassign:  bot is LoadPuzzles bot "puzzles"
fun LoadPuzzles
    bot
    dir
    say "Loading puzzles from " + dir + "..."
    var files dynamic = os_list_dir dir
    if files == empty
        say "   (no puzzle files found)"
        give bot

    repeat file in files
        var fileLen int = len(file)
        if fileLen < 4
            next
        var ext string = file[fileLen - 4:fileLen]
        if ext != ".ath"
            if ext != ".ind"
                next
        var path string = dir + "/" + file
        var name string = file[0:fileLen - 4]
        say "   🧩 " + name
        do:
            bot is LoadPuzzle bot path name
        catch as err:
            say "   ⚠️ puzzle error in " + file + ": " + err
    give bot

#! Load a single puzzle file. Returns bot.
fun LoadPuzzle
    bot
    path
    name
    var source string = file_read_text path
    var lines dynamic = split source "\n"
    give ParsePuzzle bot lines name

#! Extract all quoted "..." strings from a line, in order
fun extract_quoted
    s
    var result dynamic = []
    var i int = 0
    var n int = len(s)
    repeat
        if i >= n
            break
        if s[i] == '"'
            var start int = i + 1
            var j int = start
            repeat
                if j >= n
                    break
                if s[j] == '"'
                    result is append result (s[start:j])
                    i is j
                    break
                j is j + 1
        i is i + 1
    give result

#! Parse puzzle DSL. Returns bot.
fun ParsePuzzle
    bot
    lines
    puzzleName
    var i int = 0
    var total int = len(lines)
    var currentCmd string = ""
    var currentDesc string = ""

    repeat
        if i >= total
            break
        var line string = lines[i]
        var trimmed string = trim line
        i is i + 1

        #! skip comments and blanks
        if trimmed == ""
            next
        if len(trimmed) >= 2
            if trimmed[:2] == "#!"
                next

        #! puzzle header
        if len(trimmed) >= 7
            if trimmed[:7] == "puzzle "
                next

        #! end of puzzle
        if trimmed == "end"
            break

        #! command declaration — supports two formats:
        #!   command "name" "desc" "reply"   (one-line, all in one)
        #!   command "name" "desc"           (multi-line, followed by reply block)
        #!   name "desc" "reply"             (shorthand, no command keyword)
        var isCmd int = 0
        var rawRest string = ""
        if len(trimmed) >= 8
            if trimmed[:8] == "command "
                isCmd is 1
                rawRest is trim trimmed[8:]
        if not isCmd
            if trimmed[:1] == '"'
                isCmd is 1
                rawRest is trimmed

        if isCmd
            var toks dynamic = extract_quoted rawRest
            if len(toks) >= 1
                currentCmd is toks[0]
            currentDesc is ""
            if len(toks) >= 2
                currentDesc is toks[1]
            #! one-liner: third quoted token is the reply text
            if len(toks) >= 3
                bot is RegisterPuzzleCommand bot puzzleName currentCmd currentDesc toks[2]
            next

        #! reply body (multi-line, after command declaration)
        if len(trimmed) >= 6
            if trimmed[:6] == "reply "
                var content string = trim trimmed[6:]
                bot is RegisterPuzzleCommand bot puzzleName currentCmd currentDesc content
                next

    give bot

#! Register a puzzle command. Returns bot.
fun RegisterPuzzleCommand
    bot
    puzzle
    cmd
    desc
    replyContent
    var command dynamic = {"description": desc, "puzzle": puzzle, "reply": replyContent}
    var _cmds2 dynamic = bot.commands
    _cmds2[cmd] is command
    bot.commands is _cmds2
    give bot

#! ==============================
#! 🚀  ZERO-BOILERPLATE BOT API
#! ==============================

#! Create a bot from environment — reads DISCORD_TOKEN / BOT_TOKEN / DISCORD_PREFIX
fun BotFromEnv
    var token string = os_getenv "DISCORD_TOKEN" ""
    if token == empty or token == ""
        token is os_getenv "BOT_TOKEN" ""
    if token == empty or token == ""
        say "❌ Set DISCORD_TOKEN or BOT_TOKEN in .glo or .env"
        process_exit 1
    var prefix string = os_getenv "DISCORD_PREFIX" "!"
    give QuickBot token prefix

#! Run a bot with puzzle auto-loading
fun RunWithPuzzles
    bot
    bot is LoadPuzzles bot "puzzles"
    bot is LoadPuzzles bot "./puzzles"
    Run bot

#! ==============================
#! ✨  CLEANER HELPERS
#! ==============================

#! Shortcut for replying to a message
fun MsgReply
    token
    msg
    content
    Send token msg.channel_id content

#! Get channel from message
fun MsgChannel
    msg
    give msg.channel_id

#! Get author from message
fun MsgAuthor
    msg
    give msg.author

#! Check if message has a prefix
fun MsgHasPrefix
    msg
    prefix
    var content string = msg.content
    if len(content) < len(prefix)
        give false
    give content[:len(prefix)] == prefix

#! Get command from prefixed message
fun MsgCommand
    msg
    prefix
    var content string = msg.content
    var rest string = content[len(prefix):]
    var parts dynamic = split rest " "
    if len(parts) == 0
        give ""
    give parts[0]

#! ==============================
#! 📋  COMMAND DEFINITION HELPERS
#! ==============================

#! Define a command with a simple reply. Returns bot.
fun SimpleCommand
    bot
    name
    desc
    reply
    var cmd dynamic = {"description": desc, "reply": reply}
    var _cmds3 dynamic = bot.commands
    _cmds3[name] is cmd
    bot.commands is _cmds3
    give bot

#! Register a cog — batch-import a list of command definitions. Returns bot.
#! Each entry: {"name", "desc", "reply"} or {"name", "desc", "handler"}
#! or {"name", "desc", "handler_name"}
fun RegisterCog
    bot
    cmds
    repeat cmd in cmds
        var name string = cmd.name
        var desc string = cmd.desc
        var reply string = cmd.reply
        if reply != empty
            bot is SimpleCommand bot name desc reply
            next
        var handlerFunc dynamic = cmd.handler
        if handlerFunc != empty
            bot is AddCommand bot name desc handlerFunc
            next
        var handlerName string = cmd.handler_name
        if handlerName != empty
            bot is BotHandler bot name desc handlerName
    give bot

#! ==============================
#! 🧭  CONTEXT SYSTEM (discord.py-style)
#! ==============================
#!
#! discord.py's ctx, adapted for Indent.
#! Handler signature:  fun myHandler  ctx  args
#!   ctx.author       — the user who ran the command
#!   ctx.channel_id   — channel ID
#!   ctx.guild_id     — guild ID (empty in DMs)
#!   ctx.token        — bot token
#!   ctx.source       — raw message or interaction
#!   ctx.cmd          — command name
#!   ctx.args         — list of arguments
#!   ctx.bot          — the bot object
#!
#! Helpers: CtxSend, CtxReply, CtxEmbed, CtxEphemeral, CtxEdit

#! Build a context dict from command data
fun Ctx
    bot
    token
    source
    cmd
    args
    var author dynamic = {}
    var channelId string = ""
    var guildId string = ""
    if has_key source "author"
        if source.author != empty
            author is source.author
            channelId is source.channel_id
            guildId is source.guild_id
    if author == empty or author == {}
        if has_key source "member"
            author is source.member.user
            channelId is source.channel_id
            guildId is source.guild_id
    if author == empty or author == {}
        author is {"id": "", "username": "unknown"}
    give {"bot": bot, "token": token, "source": source, "cmd": cmd, "args": args, "author": author, "channel_id": channelId, "guild_id": guildId}

#! Send a message to the context's channel
fun CtxSend
    ctx
    content
    give Send ctx.token ctx.channel_id content

#! Reply to the context's source (message reply or interaction reply)
fun CtxReply
    ctx
    content
    give ReplyTo ctx.token ctx.source content

#! Send an embed to the context's channel
fun CtxEmbed
    ctx
    embed
    give SendEmbed ctx.token ctx.channel_id embed

#! Send an ephemeral (user-only) reply to an interaction
fun CtxEphemeral
    ctx
    content
    give InteractionEphemeral ctx.token ctx.source content

#! Edit the original interaction response
fun CtxEdit
    ctx
    content
    give InteractionEdit ctx.token ctx.source content

#! Get the author's user ID from context
fun CtxUserId
    ctx
    give ctx.author.id

#! Get the author's username from context
fun CtxUserName
    ctx
    give ctx.author.username

#! Check if context is from an interaction (vs message)
fun CtxIsInteraction
    ctx
    give has_key ctx.source "author" == false

#! Get the guild ID (empty string in DMs)
fun CtxGuildId
    ctx
    give ctx.guild_id

#! Get the channel ID
fun CtxChannelId
    ctx
    give ctx.channel_id

#! ==============================================================
#! ✨  CLEAN BLOCK API — no source["guild_id"]. No args["1"]. Just code.
#! ==============================================================
#!
#! Usage:
#!   var bot dynamic = NewBot "TOKEN" "%"
#!   fun kickCmd args
#!       kick bot user reason
#!       sendMsg bot "Kicked " + user
#!   bot is addCmd bot "kick" kickCmd ["user"]
#!
#! All functions here take `bot` as the first argument. The "current source"
#! is stashed in the module-level _CTX by RunCommand, so reply/action helpers
#! work without the caller juggling tokens/sources.

#! ---- Argument helpers ----
fun arg args n
    give args[string(n)]

fun reasonArg args
    give arg args 2

#! ---- Source helpers ----
fun guild source
    give source["guild_id"]

fun channel source
    give source["channel_id"]

fun author source
    give source["author"]["id"]

#! ---- Action helpers (auto-extract guild from source) ----
fun kickUser token source user
    Kick token guild(source) user "Kicked by command"

fun banUser token source user
    Ban token guild(source) user "Banned by command"

fun addRole token source user role
    AddRole token guild(source) user role

fun dmUser token user message
    SendDM token user message

#! ---- Reply helpers ----
fun reply token source message
    ReplyTo token source message

fun QuickEmbed
    title
    description
    color
    give {"title": title, "description": description, "color": color}

#! Send an embed reply from the bot's current context (message or interaction)
fun ReplyWithEmbed
    bot
    embed
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    if source == empty or source == {}
        give empty
    if has_key source "author"
        if source.author != empty
            var path string = "/channels/" + source.channel_id + "/messages"
            Post path token {"embeds": [embed]}
            give empty
    #! interaction source — reply via interaction callback
    var iPath string = "/interactions/" + source.id + "/" + source.token + "/callback"
    Post iPath token {"type": 4, "data": {"embeds": [embed]}}

fun replyEmbed token source title description color
    var embed dynamic = MakeEmbed title description color
    if has_key source "author"
        if source.author != empty
            var path string = "/channels/" + source.channel_id + "/messages"
            Post path token {"embeds": [embed]}
            give empty
    #! interaction source
    var iPath string = "/interactions/" + source.id + "/" + source.token + "/callback"
    Post iPath token {"type": 4, "data": {"embeds": [embed]}}

#! ---- Clean bot creator ----
fun NewBot token prefix
    give {"token": token, "prefix": prefix, "commands": {}, "handlers": {}, "user": {}, "_socketId": 0, "_ctx": {}}

#! ---- Set command context (called internally before running a command) ----
fun SetCtx
    bot
    source
    _CTX is source
    give bot

#! ---- Clean action wrappers (no token/source needed!) ----
fun kick bot user reason
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    var guildId string = source["guild_id"]
    Kick token guildId user reason

fun ban bot user reason
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    var guildId string = source["guild_id"]
    Ban token guildId user reason

fun addRole bot user role
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    var guildId string = source["guild_id"]
    AddRole token guildId user role

fun removeRole bot user role
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    var guildId string = source["guild_id"]
    RemoveRole token guildId user role

fun sendMsg bot message
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    ReplyTo token source message

#! @deprecated — use sendMsg (say is an Indent keyword, so `say bot msg` won't work)
fun say bot message
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    ReplyTo token source message

fun dm bot user message
    var token string = bot["token"]
    SendDM token user message

#! ---- Register a command (returns bot — reassign with `bot is add bot ...`) ----
fun add bot name handler
    var handlerName string = string(handler)
    var cmds dynamic = bot["commands"]
    cmds[name] is {"handler": handlerName}
    bot["commands"] is cmds
    give bot

#! ---- Register a command WITH arg metadata (recommended!) ----
#! argNames is a list like ["user", "reason"] — first arg is required, rest optional
fun addCmd bot name handler argNames
    var handlerName string = string(handler)
    var cmds dynamic = bot["commands"]
    cmds[name] is {"handler": handlerName, "args": argNames}
    bot["commands"] is cmds
    give bot

#! ---- Event registration (returns bot — reassign with `bot is on bot ...`) ----
fun on bot event handler
    var handlerName string = string(handler)
    var hdrs dynamic = bot["handlers"]
    hdrs[event] is handlerName
    bot["handlers"] is hdrs
    give bot

#! ---- Command runner (parses message, sets ctx, calls handler) ----
fun runCommand bot msg
    var content string = msg["content"]
    var prefix string = bot["prefix"]
    if starts_with(content, prefix) == FALSE
        give empty
    var rest string = slice(content, len(prefix), 9999)
    var parts dynamic = split(trim(rest), " ")
    var cmdName string = parts[0]
    var knownCmd int = 0
    if has_key bot["commands"] cmdName
        knownCmd is 1
    if not knownCmd
        give empty
    var cmdData dynamic = bot["commands"][cmdName]

    #! Build args dict
    var args dynamic = {}
    var idx int = 0
    repeat part in parts
        if idx > 0
            args[string(idx)] is part
        idx is idx + 1

    #! Set context and call handler
    SetCtx bot msg
    var handler dynamic = cmdData["handler"]
    var arg1 string = args["1"]
    var arg2 string = args["2"]
    handler bot arg1 arg2

#! ---- Puzzles loader (like Discord.py cogs) ----
fun load bot dir
    if os_exists(dir) == FALSE
        give bot
    var files dynamic = os_list_dir(dir)
    repeat file in files
        var isPuzzle int = 0
        if ends_with(file, ".ind")
            isPuzzle is 1
        or ends_with(file, ".ath")
            isPuzzle is 1
        if isPuzzle
            var path string = dir + "/" + file
            file_read_text(path)
            say "📦 Loaded puzzle: " + file
    give bot

#! ---- Start bot ----
fun start bot
    Run bot

#! ==============================================================
#! 🚀  ZERO-CONFIG QUICKSTART — the easiest possible bot
#! ==============================================================
#!
#!   get QuickStart from discord
#!   QuickStart
#!
#! Reads DISCORD_TOKEN from the environment (.glo), loads every puzzle in
#! puzzles/, and connects.  That's the whole bot.

#! Alias for BotFromEnv — create a bot from DISCORD_TOKEN / BOT_TOKEN env vars.
fun MakeBot
    var b dynamic = BotFromEnv
    give b

#! One-call bot: env token → load puzzles → connect.
fun QuickStart
    var bot dynamic = BotFromEnv
    bot is LoadPuzzles bot "puzzles"
    bot is LoadPuzzles bot "./puzzles"
    Run bot

#! ==============================================================
#! ⚡  SLASH COMMANDS
#! ==============================================================

#! Slash command option types (Discord):
#! 1=subcommand 2=subcommand_group 3=string 4=integer 5=boolean
#! 6=user 7=channel 8=role 9=mentionable 10=number

fun SlashOption name desc type required
    give {"name": name, "description": desc, "type": type, "required": required}

fun StringOption name desc required
    give SlashOption name desc 3 required
fun IntOption name desc required
    give SlashOption name desc 4 required
fun BoolOption name desc required
    give SlashOption name desc 5 required
fun UserOption name desc required
    give SlashOption name desc 6 required
fun ChannelOption name desc required
    give SlashOption name desc 7 required
fun RoleOption name desc required
    give SlashOption name desc 8 required
fun NumberOption name desc required
    give SlashOption name desc 10 required

#! Register a slash command locally. handlerName receives (ctx, args) where
#! args is a dict of option-name → value. Returns bot — reassign.
fun AddSlash
    bot
    name
    description
    handlerName
    options
    var cmds dynamic = bot.commands
    cmds[name] is {"description": description, "handler_name": handlerName, "slash": 1, "options": options}
    bot.commands is cmds
    give bot

#! Push all locally-registered slash commands to Discord (bulk overwrite).
#! Call once before Run. Returns the API response.
fun SyncSlash
    bot
    var token string = bot.token
    var cmdNames dynamic = keys bot.commands
    var list dynamic = []
    repeat name in cmdNames
        var cmd dynamic = bot.commands[name]
        if has_key cmd "slash"
            var desc string = cmd.description
            var opts dynamic = cmd.options
            var entry dynamic = {"name": name, "description": desc, "options": opts}
            list is append list entry
    if len(list) == 0
        say "   (no slash commands to sync)"
        give empty
    var path string = "/applications/@me/commands"
    give Put path token list

#! One-line convenience: a slash command with a single option.
#!   bot is SlashWithUser bot "kick" "Kick a user" "slashKick"
fun SlashWithUser bot name desc handlerName
    var opts dynamic = []
    var o dynamic = UserOption "user" "The target user" true
    opts is append opts o
    give AddSlash bot name desc handlerName opts

fun SlashWithString bot name desc handlerName
    var opts dynamic = []
    var o dynamic = StringOption "text" "Text input" true
    opts is append opts o
    give AddSlash bot name desc handlerName opts

fun SlashWithInt bot name desc handlerName
    var opts dynamic = []
    var o dynamic = IntOption "number" "Number input" true
    opts is append opts o
    give AddSlash bot name desc handlerName opts

fun SlashWithChannel bot name desc handlerName
    var opts dynamic = []
    var o dynamic = ChannelOption "channel" "Target channel" true
    opts is append opts o
    give AddSlash bot name desc handlerName opts

fun SlashWithRole bot name desc handlerName
    var opts dynamic = []
    var o dynamic = RoleOption "role" "Target role" true
    opts is append opts o
    give AddSlash bot name desc handlerName opts

#! ==============================================================
