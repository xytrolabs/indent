#! ==============================================================
#! 🎨  EMBED BUILDER
#! ==============================================================
#! Embeds are dicts; builders RETURN the modified embed — reassign:
#!   emb is AddEmbedField emb "Field" "value" true

fun BuildEmbed title description color
    give {"title": title, "description": description, "color": color}

#! Convert a hex color string ("3498DB" or "#3498DB") to a decimal color int.
#! (The native runtime does not support 0x literals — use this instead.)
fun HexColor hex
    var h string = hex
    if len(h) >= 1
        if h[:1] == "#"
            h is h[1:]
    var val int = 0
    var i int = 0
    var n int = len(h)
    repeat
        if i >= n
            break
        var ch string = h[i]
        var digit int = 0
        if ch == "0"
            digit is 0
        or ch == "1"
            digit is 1
        or ch == "2"
            digit is 2
        or ch == "3"
            digit is 3
        or ch == "4"
            digit is 4
        or ch == "5"
            digit is 5
        or ch == "6"
            digit is 6
        or ch == "7"
            digit is 7
        or ch == "8"
            digit is 8
        or ch == "9"
            digit is 9
        or ch == "a"
            digit is 10
        or ch == "A"
            digit is 10
        or ch == "b"
            digit is 11
        or ch == "B"
            digit is 11
        or ch == "c"
            digit is 12
        or ch == "C"
            digit is 12
        or ch == "d"
            digit is 13
        or ch == "D"
            digit is 13
        or ch == "e"
            digit is 14
        or ch == "E"
            digit is 14
        or ch == "f"
            digit is 15
        or ch == "F"
            digit is 15
        val is val * 16 + digit
        i is i + 1
    give val

fun EmbedField name value inline
    give {"name": name, "value": value, "inline": inline}

fun AddEmbedField embed name value inline
    var fields dynamic = []
    if has_key embed "fields"
        fields is embed.fields
    var field dynamic = EmbedField name value inline
    fields is append fields field
    embed["fields"] is fields
    give embed

fun SetEmbedFooter embed text iconUrl
    embed["footer"] is {"text": text, "icon_url": iconUrl}
    give embed

fun SetEmbedImage embed url
    embed["image"] is {"url": url}
    give embed

fun SetEmbedThumbnail embed url
    embed["thumbnail"] is {"url": url}
    give embed

fun SetEmbedAuthor embed name url iconUrl
    embed["author"] is {"name": name, "url": url, "icon_url": iconUrl}
    give embed

fun SetEmbedTimestamp embed ts
    embed["timestamp"] is ts
    give embed

#! ==============================================================
#! 🔘  MESSAGE COMPONENTS (buttons, menus, action rows)
#! ==============================================================

fun Button style label customId
    give {"type": 2, "style": style, "label": label, "custom_id": customId}

fun PrimaryButton label customId
    give Button 1 label customId
fun SecondaryButton label customId
    give Button 2 label customId
fun SuccessButton label customId
    give Button 3 label customId
fun DangerButton label customId
    give Button 4 label customId

fun LinkButton label url
    give {"type": 2, "style": 5, "label": label, "url": url}

fun ActionRow components
    give {"type": 1, "components": components}

fun SelectOption label value desc
    give {"label": label, "value": value, "description": desc}

fun SelectMenu customId options
    give {"type": 3, "custom_id": customId, "options": options}

fun TextInput customId label style
    give {"type": 4, "custom_id": customId, "label": label, "style": style}

#! Send a message with action-row components to a channel
fun SendWithComponents
    token
    channelId
    content
    rows
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content, "components": rows}

#! Reply (to the current context) with components
fun ReplyWithComponents
    bot
    content
    rows
    var token string = bot["token"]
    var source dynamic = _CTX
    if source == empty or source == {}
        if has_key bot "_ctx"
            source is bot["_ctx"]
    if source == empty or source == {}
        give empty
    if has_key source "author"
        if source.author != empty
            var path string = "/channels/" + source.channel_id + "/messages"
            Post path token {"content": content, "components": rows}
            give empty
    #! interaction source
    var iPath string = "/interactions/" + source.id + "/" + source.token + "/callback"
    Post iPath token {"type": 4, "data": {"content": content, "components": rows}}

#! Send components to a ctx's channel
fun CtxComponents ctx content rows
    give SendWithComponents ctx.token ctx.channel_id content rows

#! Ephemeral reply with components (interaction only)
fun CtxEphemeralComponents ctx content rows
    var iPath string = "/interactions/" + ctx.source.id + "/" + ctx.source.token + "/callback"
    give Post iPath ctx.token {"type": 4, "data": {"content": content, "components": rows, "flags": 64}}

