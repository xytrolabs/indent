#! Set the bot's status: "online", "idle", "dnd", "invisible"
fun SetStatus
    bot
    status
    var socketId int = _SOCKET
    if socketId <= 0
        give empty
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [], "status": status, "afk": false}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

#! Set activity: Playing <name>
fun SetPlaying
    bot
    name
    var socketId int = _SOCKET
    if socketId <= 0
        give empty
    var act dynamic = {"name": name, "type": 0}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": "online", "afk": false}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

#! Set activity: Watching <name>
fun SetWatching
    bot
    name
    var socketId int = _SOCKET
    if socketId <= 0
        give empty
    var act dynamic = {"name": name, "type": 3}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": "online", "afk": false}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

#! Set activity: Listening to <name>
fun SetListening
    bot
    name
    var socketId int = _SOCKET
    if socketId <= 0
        give empty
    var act dynamic = {"name": name, "type": 2}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": "online", "afk": false}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

#! Set activity: Competing in <name>
fun SetCompeting
    bot
    name
    var socketId int = _SOCKET
    if socketId <= 0
        give empty
    var act dynamic = {"name": name, "type": 5}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": "online", "afk": false}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

#! ==============================================================
#! 🎨  EMBED BUILDER
#! ==============================================================
#! Embeds are dicts; builders RETURN the modified embed — reassign:
#!   emb is AddEmbedField emb "Field" "value" true

fun BuildEmbed title description color
    give {"title": title, "description": description, "color": color}

#! Convert a hex color string ("3498DB" or "#3498DB") to a decimal color int.
#! (The native runtime does not support 0x literals — use this instead.)
fun HexColor hex
    var h string = hex
    if len(h) >= 1
        if h[:1] == "#"
            h is h[1:]
    var val int = 0
    var i int = 0
    var n int = len(h)
    repeat
        if i >= n
            break
        var ch string = h[i]
        var digit int = 0
        if ch == "0"
            digit is 0
        or ch == "1"
            digit is 1
        or ch == "2"
            digit is 2
        or ch == "3"
            digit is 3
        or ch == "4"
            digit is 4
        or ch == "5"
            digit is 5
        or ch == "6"
            digit is 6
        or ch == "7"
            digit is 7
        or ch == "8"
            digit is 8
        or ch == "9"
            digit is 9
        or ch == "a"
            digit is 10
        or ch == "A"
            digit is 10
        or ch == "b"
            digit is 11
        or ch == "B"
            digit is 11
        or ch == "c"
            digit is 12
        or ch == "C"
            digit is 12
        or ch == "d"
            digit is 13
        or ch == "D"
            digit is 13
        or ch == "e"
            digit is 14
        or ch == "E"
            digit is 14
        or ch == "f"
            digit is 15
        or ch == "F"
            digit is 15
        val is val * 16 + digit
        i is i + 1
    give val

fun EmbedField name value inline
    give {"name": name, "value": value, "inline": inline}

fun AddEmbedField embed name value inline
    var fields dynamic = []
    if has_key embed "fields"
        fields is embed.fields
    var field dynamic = EmbedField name value inline
    fields is append fields field
    embed["fields"] is fields
    give embed

fun SetEmbedFooter embed text iconUrl
    embed["footer"] is {"text": text, "icon_url": iconUrl}
    give embed

fun SetEmbedImage embed url
    embed["image"] is {"url": url}
    give embed

fun SetEmbedThumbnail embed url
    embed["thumbnail"] is {"url": url}
    give embed

fun SetEmbedAuthor embed name url iconUrl
    embed["author"] is {"name": name, "url": url, "icon_url": iconUrl}
    give embed

fun SetEmbedTimestamp embed ts
    embed["timestamp"] is ts
    give embed

