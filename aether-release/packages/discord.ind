#! =============================================================================
#! discord.ind 3.0 — The Indent Discord bot library
#! =============================================================================
#!
#! A standalone Discord library (like discord.py): REST API, WebSocket Gateway,
#! command routing, event system, puzzle/cog loader, a discord.py-style `ctx`
#! system, clean block-style helpers, and a built-in audit/monitoring suite.
#! Import it and write your bot.
#!
#! v3.0 adds: message monitoring (edits, deletes, bulk-deletes, pins,
#! reactions), moderation events (bans/unbans, member/voice/channel changes),
#! a message cache, and one-call SetupAudit logging. Gateway intents now
#! default to a broad non-privileged set — override with bot.intents.
#!
#! NOTE: the native Indent runtime passes function arguments by value, so every
#! function that modifies the bot RETURNS the modified bot. Always reassign:
#!   bot is addCmd bot "kick" kickCmd ["user"]
#!   bot is LoadPuzzles bot "puzzles"
#!
#! 🚀 3-line bot:
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   Run bot
#!
#! ⚡ With commands:
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   AddCommand bot "ping" "Check latency" handler
#!   On bot "ready" readyHandler
#!   Run bot
#!
#! 📋 Audit log (new in 3.0):
#!   get QuickBot, SetupAudit from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   bot is SetupAudit bot "123456789012345678"   # <- channel id for logs
#!   Run bot
#!
#! 🧭 discord.py-style ctx:
#!   get CtxSend from discord
#!   fun greet ctx args
#!       CtxSend ctx "Hello!"
#!   bot is BotHandler bot "greet" "Greet people" "greet"
#!
#! 📖 Full reference: docs/discord-package.md
#! =============================================================================

#! ---- constants ----
var API string = "https://discord.com/api/v10"
var GatewayURL string = "wss://gateway.discord.gg/?v=10&encoding=json"

#! discord package version
var DiscordVersion string = "3.0.0"

#! Current source/context for the clean block API (module-level, shared).
#! The native runtime passes args by value, so we stash the "current source"
#! here so sendMsg/kick/ban/etc. can reply without needing bot._ctx to mutate.
var _CTX dynamic = {}

#! Current gateway socket id (module-level, shared) — used by presence helpers.
var _SOCKET int = 0

#! Lightweight in-memory message cache (keyed by message id) so MESSAGE_DELETE
#! / MESSAGE_UPDATE handlers can see the last-known message content.
var _MSG_CACHE dynamic = {}

fun CacheMessage
    msg
    if has_key msg "id"
        var mid string = msg.id
        _MSG_CACHE[mid] is msg

fun LookupMessage
    mid
    if has_key _MSG_CACHE mid
        give _MSG_CACHE[mid]
    give empty

fun ClearMessageCache
    _MSG_CACHE is {}

#! ==============================
#! 🔌  REST API (low level)
#! ==============================

fun Get
    path
    token
    var url string = API + path
    var auth string = "Bot " + token
    give http_get url auth

fun Post
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_post_json url body auth

fun Put
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_put_json url body auth

fun Patch
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_patch_json url body auth

fun Delete
    path
    token
    var url string = API + path
    var auth string = "Bot " + token
    give http_delete url auth

#! ---- message actions ----
fun Send
    token
    channelId
    content
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content}

fun Reply
    token
    channelId
    messageId
    content
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content, "message_reference": {"message_id": messageId}}

fun SendEmbed
    token
    channelId
    embed
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"embeds": [embed]}

fun MakeEmbed
    title
    description
    color
    give {"title": title, "description": description, "color": color}

fun Edit
    token
    channelId
    messageId
    content
    var path string = "/channels/" + channelId + "/messages/" + messageId
    give Patch path token {"content": content}

fun DeleteMsg
    token
    channelId
    messageId
    var path string = "/channels/" + channelId + "/messages/" + messageId
    give Delete path token

fun React
    token
    channelId
    messageId
    emoji
    var path string = "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    give Put path token {}

fun SendDM
    token
    userId
    content
    var ch dynamic = Post "/users/@me/channels" token {"recipient_id": userId}
    give Send token ch.id content

#! ---- moderation ----
fun Kick
    token
    guildId
    userId
    reason
    var url string = "/guilds/" + guildId + "/members/" + userId
    give Delete url token {"reason": reason}

fun Ban
    token
    guildId
    userId
    reason
    var url string = "/guilds/" + guildId + "/bans/" + userId
    give Put url token {"reason": reason}

fun Unban
    token
    guildId
    userId
    var url string = "/guilds/" + guildId + "/bans/" + userId
    give Delete url token {}

fun Timeout
    token
    guildId
    userId
    seconds
    var url string = "/guilds/" + guildId + "/members/" + userId
    var until float = time_now + seconds
    give Patch url token {"communication_disabled_until": until}

fun AddRole
    token
    guildId
    userId
    roleId
    var url string = "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId
    give Put url token {}

fun RemoveRole
    token
    guildId
    userId
    roleId
    var url string = "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId
    give Delete url token {}

#! ---- guild & user info ----
fun GetUser
    token
    userId
    var url string = "/users/" + userId
    give Get url token

fun GetGuild
    token
    guildId
    var url string = "/guilds/" + guildId
    give Get url token

fun GetChannel
    token
    channelId
    var url string = "/channels/" + channelId
    give Get url token

#! ---- gateway ----
fun WsConnect
    give ws_connect GatewayURL

fun WsSend
    socketId
    payload
    give ws_send_text socketId payload

fun WsRecv
    socketId
    give ws_recv_text socketId

fun WsRecvTimeout
    socketId
    secs
    give ws_recv_text_timeout socketId secs

fun WsClose
    socketId
    give ws_close socketId

#! ==============================
#! 🤖  BOT ENGINE (mid level)
#! ==============================

#! Default gateway intents: broad but NON-privileged (avoids 4014 on bots
#! without GUILD_MEMBERS/GUILD_PRESENCES whitelisted in the Developer Portal).
#! Set bot.intents to override, e.g. bot.intents is 33281 for a minimal bot.
var DEFAULT_INTENTS int = 130797

fun Identify
    token
    socketId
    intents
    var payload dynamic = {"op": 2, "d": {"token": token, "intents": intents, "properties": {"os": "linux", "browser": "indent", "device": "indent"}}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

fun SetPresence
    token
    status
    activityName
    activityType
    var act dynamic = empty
    if activityName != empty
        act is {"name": activityName, "type": activityType}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": status, "afk": false}}

fun HandleDispatch
    bot
    token
    event
    var t string = event.t
    var d dynamic = event.d

    if t == "READY"
        bot.user is d.user
        say "✅ Logged in as: " + d.user.username
        CallEvent bot "ready" d

    or t == "MESSAGE_CREATE"
        CacheMessage d
        HandleMessage bot token d

    or t == "MESSAGE_UPDATE"
        CacheMessage d
        CallEvent bot "message_edit" d

    or t == "MESSAGE_DELETE"
        var delMsg dynamic = LookupMessage d.id
        if delMsg != empty
            CallEvent bot "message_delete" delMsg
        otherwise
            CallEvent bot "message_delete" d

    or t == "MESSAGE_DELETE_BULK"
        CallEvent bot "message_bulk_delete" d

    or t == "CHANNEL_PIN_UPDATE"
        CallEvent bot "pin_update" d

    or t == "MESSAGE_REACTION_ADD"
        CallEvent bot "reaction_add" d

    or t == "MESSAGE_REACTION_REMOVE"
        CallEvent bot "reaction_remove" d

    or t == "MESSAGE_REACTION_REMOVE_ALL"
        CallEvent bot "reaction_remove_all" d

    or t == "MESSAGE_REACTION_REMOVE_EMOJI"
        CallEvent bot "reaction_remove_emoji" d

    or t == "GUILD_BAN_ADD"
        CallEvent bot "ban_add" d

    or t == "GUILD_BAN_REMOVE"
        CallEvent bot "ban_remove" d

    or t == "GUILD_MEMBER_UPDATE"
        CallEvent bot "member_update" d

    or t == "VOICE_STATE_UPDATE"
        CallEvent bot "voice_state_update" d

    or t == "GUILD_UPDATE"
        CallEvent bot "guild_update" d

    or t == "CHANNEL_CREATE"
        CallEvent bot "channel_create" d

    or t == "CHANNEL_UPDATE"
        CallEvent bot "channel_update" d

    or t == "CHANNEL_DELETE"
        CallEvent bot "channel_delete" d

    or t == "INTERACTION_CREATE"
        HandleInteraction bot token d

    or t == "GUILD_CREATE"
        CallEvent bot "guild_join" d

    or t == "GUILD_MEMBER_ADD"
        CallEvent bot "member_join" d

    or t == "GUILD_MEMBER_REMOVE"
        CallEvent bot "member_leave" d

fun HandleMessage
    bot
    token
    msg
    #! skip own messages
    if has_key msg "author"
        if msg.author != empty
            if has_key msg.author "id"
                if has_key bot "user"
                    if bot.user != empty
                        if has_key bot.user "id"
                            if msg.author.id == bot.user.id
                                give empty

    var content string = ""
    if has_key msg "content"
        content is msg.content

    var prefix string = ""
    if has_key bot "prefix"
        prefix is bot.prefix

    #! check prefix and dispatch command
    if prefix != empty and prefix != ""
        if len(content) >= len(prefix)
            if content[:len(prefix)] == prefix
                var rest string = content[len(prefix):]
                var parts dynamic = split rest " "
                var cmd string = parts[0]
                #! args are passed as a list (parts[1:])
                var args dynamic = []
                if len(parts) > 1
                    args is parts[1:]
                do:
                    RunCommand bot token msg cmd args
                catch as err:
                    var errMsg string = "❌ Error: " + err
                    ReplyTo token msg errMsg
                give empty

    #! call user message handler (errors don't crash the bot)
    do:
        CallEvent bot "message" msg
    catch as err:
        give empty

fun HandleInteraction
    bot
    token
    interaction
    var cmdData dynamic = empty
    if has_key interaction "data"
        cmdData is interaction.data
    if cmdData == empty
        Acknowledge token interaction
        give empty

    var hasName int = 0
    var hasCustom int = 0
    if has_key cmdData "name"
        hasName is 1
    if has_key cmdData "custom_id"
        hasCustom is 1

    #! ---- dispatch ALL custom_id interactions (buttons, menus) to user code ----
    if hasCustom
        do:
            CallEvent bot "interaction" interaction
        catch as err:
            say "   ⚠️ interaction handler error: " + err
        give empty

    #! ---- unknown interactions (no name, no custom_id) — just acknowledge ----
    if not hasName
        Acknowledge token interaction
        give empty

    #! ---- slash commands ----
    var name string = cmdData.name
    var opts dynamic = {}
    if has_key cmdData "options"
        var args dynamic = cmdData.options
        if args != empty
            repeat item in args
                if has_key item "name"
                    var itemName string = item.name
                    if has_key item "value"
                        opts[itemName] is item.value
    Acknowledge token interaction
    RunCommand bot token interaction name opts

fun Acknowledge
    token
    interaction
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 5}

fun InteractionReply
    token
    interaction
    content
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"content": content}}

#! Send an ephemeral (user-only) reply to an interaction
fun InteractionEphemeral
    token
    interaction
    content
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"content": content, "flags": 64}}

#! Defer an interaction (show loading, then send followup later)
fun InteractionDefer
    token
    interaction
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 5}

#! Edit the original interaction response (followup via webhook)
fun InteractionEdit
    token
    interaction
    content
    var path string = "/webhooks/" + interaction.application_id + "/" + interaction.token + "/messages/@original"
    Patch path token {"content": content}

fun InteractionEmbed
    token
    interaction
    embed
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"embeds": [embed]}}

fun RunCommand
    bot
    token
    source
    cmd
    args
    #! remember the current source so clean-block helpers can reply
    _CTX is source

    #! built-in: ping (measures REST latency)
    if cmd == "ping"
        var start float = time_perf_counter
        var pingUrl string = API + "/users/@me"
        var pingAuth string = "Bot " + token
        http_get pingUrl pingAuth
        var end float = time_perf_counter
        var ms float = (end - start) * 1000.0
        var pingMsg string = "Pong! (" + string(ms) + "ms)"
        ReplyTo token source pingMsg
        give empty

    #! built-in: help (lists commands)
    or cmd == "help"
        var cmds string = ""
        var cmdKeys dynamic = keys bot.commands
        repeat k in cmdKeys
            if cmds != empty
                cmds is cmds + ", "
            cmds is cmds + "`" + k + "`"
        var helpMsg string = "Commands: " + cmds
        ReplyTo token source helpMsg
        give empty

    #! unknown command
    var knownCmd int = 0
    if has_key bot.commands cmd
        knownCmd is 1
    if not knownCmd
        var unknownMsg string = "Unknown: `" + cmd + "`"
        ReplyTo token source unknownMsg
        give empty

    var command dynamic = bot.commands[cmd]

    #! 1) simple reply command (from puzzles or SimpleCommand)
    if has_key command "reply"
        var reply dynamic = command.reply
        if reply != empty
            ReplyTo token source reply
            give empty

    #! 2) handler_name command (ctx API / BotHandler) — dispatch via "command" event
    if has_key command "handler_name"
        var handlerName dynamic = command.handler_name
        if handlerName != empty
            CallEvent bot "command" {"cmd": cmd, "token": token, "source": source, "args": args, "handler_name": handlerName}
            give empty

    #! 3) handler command (function reference, from add/addCmd) — dict-style args
    if has_key command "handler"
        var handlerFunc dynamic = command.handler

        #! build dict args {"1": ..., "2": ...} from the raw list
        var dictArgs dynamic = {"1": empty, "2": empty, "3": empty, "4": empty, "5": empty, "6": empty, "7": empty, "8": empty, "9": empty}
        var idx int = 1
        repeat item in args
            dictArgs[string(idx)] is item
            idx is idx + 1

        #! auto-validate required args if registered with addCmd
        if has_key command "args"
            var argNames dynamic = command.args
            var j int = 1
            repeat expected in argNames
                var key string = string(j)
                var val dynamic = dictArgs[key]
                if val == empty or val == ""
                    var errMsg string = "❌ Missing argument " + key + ": " + expected
                    ReplyTo token source errMsg
                    give empty
                j is j + 1

        do:
            call_func handlerFunc dictArgs
        catch as err:
            var cmdErrMsg string = "❌ Command error: " + err
            ReplyTo token source cmdErrMsg
        give empty

    ReplyTo token source "Command has no action"

fun ReplyTo
    token
    source
    content
    if has_key source "author"
        if source.author != empty
            Reply token source.channel_id source.id content
            give empty
    #! interaction source
    InteractionReply token source content

fun CallEvent
    bot
    event
    args
    var handlers dynamic = bot.handlers
    var keysList dynamic = keys handlers
    var found string = ""
    repeat k in keysList
        if k == event
            found is handlers[k]
    if found != empty and found != ""
        call_func found bot args ""

#! ==============================
#! 🎯  QUICKBOT API (high level)
#! ==============================

#! Create a bot — one function call
fun QuickBot
    token
    prefix
    give {"token": token, "prefix": prefix, "commands": {}, "handlers": {}, "user": {}, "_socketId": 0}

#! Add a prefix command (handler = function reference — limited support)
#! Returns bot — reassign:  bot is AddCommand bot "name" "desc" handler
fun AddCommand
    bot
    name
    description
    handler
    var _cmds4 dynamic = bot.commands
    _cmds4[name] is {"description": description, "handler": handler}
    bot.commands is _cmds4
    give bot

#! Add a handler-based command (handler_name = string function name)
#! The handler is dispatched through the "command" event with a ctx object:
#!   fun myHandler ctx args
#!       CtxSend ctx "Hello!"
#! Returns bot — reassign:  bot is BotHandler bot "name" "desc" "handlerName"
fun BotHandler
    bot
    name
    desc
    handlerName
    var _cmds5 dynamic = bot.commands
    _cmds5[name] is {"description": desc, "handler_name": handlerName}
    bot.commands is _cmds5
    give bot

#! Add an event handler (handler is a string function name or a callable)
#! Returns bot — reassign:  bot is On bot "ready" "onReady"
fun On
    bot
    event
    handler
    var _handlers2 dynamic = bot.handlers
    _handlers2[event] is handler
    bot.handlers is _handlers2
    give bot

#! ==============================
#! 📋  AUDIT / MONITORING (3.0)
#! ==============================
#! SetupAudit registers handlers for every monitoring event and posts a
#! summary embed to the given channel. Call once during setup:
#!   bot is SetupAudit bot "123456789012345678"
var _AUDIT_CHANNEL string = ""
var _AUDIT_ENABLED int = 0

fun AuditPost
    bot
    title
    desc
    color
    if _AUDIT_ENABLED == 0
        give empty
    var emb dynamic = BuildEmbed title desc color
    give SendEmbed bot.token _AUDIT_CHANNEL emb

fun AuditAuthor
    data
    var author string = "?"
    if has_key data "author"
        if has_key data.author "username"
            author is data.author.username
    give author

fun AuditChannelId
    data
    var chan string = "?"
    if has_key data "channel_id"
        chan is data.channel_id
    give chan

fun AuditContent
    data
    var content string = ""
    if has_key data "content"
        content is data.content
    give content

fun AuditUserName
    data
    var user string = "?"
    if has_key data "user"
        if has_key data.user "username"
            user is data.user.username
    give user

fun AuditMessageEdit
    bot
    data
    _x
    var author string = AuditAuthor data
    var chan string = AuditChannelId data
    var content string = AuditContent data
    var title string = "✏️ Message edited"
    var desc string = "Channel: " + chan + "\nAuthor: " + author + "\nContent: " + content
    AuditPost bot title desc "FFA500"

fun AuditMessageDelete
    bot
    data
    _x
    var author string = AuditAuthor data
    var chan string = AuditChannelId data
    var content string = AuditContent data
    var title string = "🗑️ Message deleted"
    var desc string = "Channel: " + chan + "\nAuthor: " + author + "\nContent: " + content
    AuditPost bot title desc "FF0000"

