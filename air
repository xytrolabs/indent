#!/usr/bin/env bash
# AIR — Accessible Indent Registry — pip-like package manager for Indent
# Usage: air <command> [args]
set -euo pipefail

AIR_HOME="${HOME}/.local/share/indent"
AIR_PACKAGES="${AIR_HOME}/air-packages"
AIR_CACHE="${AIR_HOME}/air-cache"
AIR_REGISTRY="${AIR_REGISTRY:-https://raw.githubusercontent.com/xytrolabs/air/main}"
AIR_INDEX="${AIR_REGISTRY}/packages/index.txt"
AIR_CONFIG="${AIR_HOME}/air.conf"

# ── Help ────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
AIR — Indent Package Manager (pip for Indent)

Usage:
  air install <name>[@version]     Install a package
  air install <name> <url>         Install from URL or local path
  air uninstall <name>             Remove a package
  air update [name]                Update one or all packages
  air search <query>               Search registry for packages
  air list                         List installed packages
  air info <name>                  Show package details
  air init                         Initialize a new Indent project

Examples:
  air install colors               Install latest from registry
  air install math@2.5.0           Install specific version
  air install mypkg ./mypkg.ind    Install from local file
  air uninstall colors             Remove package
  air update                       Update all installed packages
  air update math                  Update specific package
  air search json                  Find json-related packages
  air list                         Show what's installed
  air info math                    Show package metadata
EOF
}

# ── Config ──────────────────────────────────────────────────────────
load_config() {
  mkdir -p "$AIR_HOME" "$AIR_PACKAGES" "$AIR_CACHE"
  if [[ -f "$AIR_CONFIG" ]]; then
    source "$AIR_CONFIG"
  fi
}

save_config() {
  mkdir -p "$(dirname "$AIR_CONFIG")"
  {
    echo "AIR_REGISTRY='${AIR_REGISTRY}'"
    echo "AIR_INDEX='${AIR_INDEX}'"
  } > "$AIR_CONFIG"
}

# ── Index ───────────────────────────────────────────────────────────
fetch_index() {
  local idx="$1"
  local cache_file="${AIR_CACHE}/index-$(echo "$idx" | sha256sum | cut -c1-16).txt"
  
  # Use cached index if less than 30 minutes old
  if [[ -f "$cache_file" ]] && [[ $(($(date +%s) - $(stat -c %Y "$cache_file"))) -lt 1800 ]]; then
    cat "$cache_file"
    return
  fi

  if [[ "$idx" =~ ^https?:// ]]; then
    if curl -fsSL --connect-timeout 5 --max-time 15 "$idx" -o "$cache_file" 2>/dev/null; then
      cat "$cache_file"
    else
      echo "⚠ Cannot reach registry: $idx" >&2
      return 1
    fi
  elif [[ -f "$idx" ]]; then
    cat "$idx"
  else
    echo "⚠ No registry index found" >&2
    return 1
  fi
}

resolve_package() {
  local name="$1"
  local index_data
  index_data="$(fetch_index "$AIR_INDEX")" || exit 1

  local line
  line="$(echo "$index_data" | awk -F'|' -v pkg="$name" '
    /^[[:space:]]*#/ { next }
    NF >= 2 {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
      if ($1 == pkg) { print; exit }
    }
  ')"

  if [[ -z "$line" ]]; then
    echo "✗ Package '$name' not found in registry" >&2
    exit 1
  fi

  echo "$line"
}

# ── Install ─────────────────────────────────────────────────────────
cmd_install() {
  load_config

  if [[ $# -lt 1 ]]; then
    echo "Usage: air install <name>[@version] [source]" >&2
    exit 1
  fi

  local raw="$1"
  local name="${raw%@*}"
  local ver="${raw##*@}"
  [[ "$ver" == "$raw" ]] && ver=""
  
  local source="${2:-}"
  
  # Resolve source if not explicitly given
  if [[ -z "$source" ]]; then
    local pkg_line
    pkg_line="$(resolve_package "$name")"
    source="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}')"
    local desc="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $4); print $4}')"
    
    # If name|source|sha256|description (4 fields), extract sha256
    local sha="$(echo "$pkg_line" | awk -F'|' 'NF>=4 {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); if ($3~/^[a-f0-9]{64}$/) print $3}')"
    
    # Make relative paths absolute
    if [[ ! "$source" =~ ^https?:// ]]; then
      source="${AIR_REGISTRY}/packages/${source#./}"
    fi
    
    echo "📦 Installing ${name}..."
    [[ -n "$desc" ]] && echo "   $desc"
    [[ -n "$ver" ]] && echo "   Version: $ver"
  else
    echo "📦 Installing ${name} from ${source}..."
  fi

  local target="${AIR_PACKAGES}/${name}.ind"
  
  # Download or copy
  if [[ "$source" =~ ^https?:// ]]; then
    if ! curl -fsSL --connect-timeout 10 --max-time 60 "$source" -o "$target"; then
      echo "✗ Failed to download: $source" >&2
      exit 1
    fi
  else
    if [[ ! -f "$source" ]]; then
      echo "✗ Source file not found: $source" >&2
      exit 1
    fi
    cp "$source" "$target"
  fi

  # Verify SHA256 if available
  local actual_sha
  actual_sha="$(sha256sum "$target" | awk '{print $1}')"
  if [[ -n "${sha:-}" ]] && [[ "$sha" != "$actual_sha" ]]; then
    echo "⚠ SHA256 mismatch! Expected: ${sha:0:16}... Got: ${actual_sha:0:16}..." >&2
    rm -f "$target"
    exit 1
  fi

  # Record in installed list
  local installed="${AIR_HOME}/installed.txt"
  touch "$installed"
  # Remove old entry
  grep -v "^${name}|" "$installed" > "${installed}.tmp" 2>/dev/null || true
  mv "${installed}.tmp" "$installed" 2>/dev/null || true
  echo "${name}|${source}|${actual_sha}|$(date -Iseconds)" >> "$installed"

  echo "✅ Installed ${name} → ${target}"
}

# ── Uninstall ───────────────────────────────────────────────────────
cmd_uninstall() {
  load_config
  
  if [[ $# -lt 1 ]]; then
    echo "Usage: air uninstall <name>" >&2
    exit 1
  fi

  local name="$1"
  local target="${AIR_PACKAGES}/${name}.ind"

  if [[ -f "$target" ]]; then
    rm -f "$target"
    echo "🗑 Removed ${target}"
  else
    echo "⚠ Package '$name' not found at ${target}" >&2
  fi

  # Remove from installed list
  local installed="${AIR_HOME}/installed.txt"
  if [[ -f "$installed" ]]; then
    grep -v "^${name}|" "$installed" > "${installed}.tmp" 2>/dev/null || true
    mv "${installed}.tmp" "$installed" 2>/dev/null || true
  fi

  echo "✅ Uninstalled ${name}"
}

# ── Update ──────────────────────────────────────────────────────────
cmd_update() {
  load_config

  local installed="${AIR_HOME}/installed.txt"
  if [[ ! -f "$installed" ]]; then
    echo "No packages installed"
    return
  fi

  if [[ $# -eq 1 ]]; then
    # Update specific package
    local name="$1"
    local entry
    entry="$(grep "^${name}|" "$installed" 2>/dev/null || true)"
    if [[ -z "$entry" ]]; then
      echo "✗ Package '$name' is not installed" >&2
      exit 1
    fi
    local source="$(echo "$entry" | awk -F'|' '{print $2}')"
    echo "🔄 Updating ${name}..."
    cmd_install "$name" "$source"
  else
    # Update all
    echo "🔄 Updating all packages..."
    while IFS='|' read -r name source rest; do
      [[ -z "$name" ]] && continue
      echo "  Updating ${name}..."
      cmd_install "$name" "$source"
    done < "$installed"
  fi
}

# ── Search ──────────────────────────────────────────────────────────
cmd_search() {
  load_config
  
  if [[ $# -lt 1 ]]; then
    echo "Usage: air search <query>" >&2
    exit 1
  fi

  local query="$1"
  local index_data
  index_data="$(fetch_index "$AIR_INDEX")" || exit 1

  echo "🔍 Packages matching '$query':"
  echo ""
  
  local found=0
  while IFS='|' read -r name source sha desc; do
    # Skip header/comments
    [[ "$name" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$name" ]] && continue
    
    name="$(echo "$name" | xargs)"
    desc="$(echo "${desc:-}" | xargs)"
    source="$(echo "${source:-}" | xargs)"
    
    local search_text
    search_text="$(echo "${name} ${desc} ${source}" | tr '[:upper:]' '[:lower:]')"
    
    if [[ "$search_text" == *"$(echo "$query" | tr '[:upper:]' '[:lower:]')"* ]]; then
      printf "  %-20s %s\n" "$name" "$desc"
      found=$((found + 1))
    fi
  done <<< "$index_data"

  if [[ $found -eq 0 ]]; then
    echo "  (no results)"
  fi
  echo ""
}

# ── List ────────────────────────────────────────────────────────────
cmd_list() {
  load_config

  local installed="${AIR_HOME}/installed.txt"
  if [[ ! -f "$installed" ]] || [[ ! -s "$installed" ]]; then
    echo "No packages installed"
    echo ""
    echo "Install packages with: air install <name>"
    return
  fi

  echo "📦 Installed packages:"
  echo ""
  printf "  %-20s %-50s %s\n" "NAME" "SOURCE" "INSTALLED"
  printf "  %-20s %-50s %s\n" "----" "------" "---------"
  
  while IFS='|' read -r name source sha date; do
    [[ -z "$name" ]] && continue
    local short_source="${source:0:47}..."
    [[ ${#source} -le 50 ]] && short_source="$source"
    local short_date="${date:0:10}"
    printf "  %-20s %-50s %s\n" "$name" "$short_source" "$short_date"
  done < "$installed"
  echo ""
}

# ── Info ────────────────────────────────────────────────────────────
cmd_info() {
  load_config

  if [[ $# -lt 1 ]]; then
    echo "Usage: air info <name>" >&2
    exit 1
  fi

  local name="$1"
  local pkg_line
  pkg_line="$(resolve_package "$name")" || exit 1

  local source desc sha
  source="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}')"
  sha="$(echo "$pkg_line" | awk -F'|' 'NF>=4 {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); if ($3~/^[a-f0-9]{64}$/) print $3; else print "N/A"}')"
  desc="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $4); print $4}')"

  # Check if installed
  local installed="${AIR_HOME}/installed.txt"
  local status="not installed"
  local inst_date=""
  if [[ -f "$installed" ]]; then
    local entry
    entry="$(grep "^${name}|" "$installed" 2>/dev/null || true)"
    if [[ -n "$entry" ]]; then
      status="✓ installed"
      inst_date="$(echo "$entry" | awk -F'|' '{print $4}')"
    fi
  fi

  echo ""
  echo "📦 ${name}"
  echo "   Description: ${desc:-N/A}"
  echo "   Source:      ${source}"
  echo "   SHA256:      ${sha:-N/A}"
  echo "   Status:      ${status}"
  [[ -n "$inst_date" ]] && echo "   Installed:   ${inst_date:0:10}"
  echo ""
}

# ── Init ────────────────────────────────────────────────────────────
cmd_init() {
  if [[ -f "indent.toml" ]]; then
    echo "indent.toml already exists"
  else
    cat > indent.toml <<'EOF'
[package]
name = "my-project"
version = "0.1.0"

[dependencies]
EOF
    echo "✅ Created indent.toml"
  fi
  echo "Ready! Use 'air install <name>' to add dependencies."
}

# ── Main ────────────────────────────────────────────────────────────
main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    install|add|i)      cmd_install "$@" ;;
    uninstall|remove|rm) cmd_uninstall "$@" ;;
    update|upgrade|up)   cmd_update "$@" ;;
    search|find|s)       cmd_search "$@" ;;
    list|ls)             cmd_list "$@" ;;
    info|show)           cmd_info "$@" ;;
    init)                cmd_init "$@" ;;
    help|--help|-h)      usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      echo "Run 'air help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
