#!/usr/bin/env bash
# AIR — Accessible Indent Registry — pip-like package manager for Indent
# Usage: air <command> [args]
set -euo pipefail

AIR_HOME="${HOME}/.local/share/indent"
AIR_PACKAGES="${AIR_HOME}/air-packages"
AIR_CACHE="${AIR_HOME}/air-cache"
AIR_REGISTRY="${AIR_REGISTRY:-https://raw.githubusercontent.com/xytrolabs/air/main}"
AIR_INDEX="${AIR_REGISTRY}/packages/index.txt"
AIR_DELIVERY_INDEX="${AIR_REGISTRY}/deliveries/index.txt"
AIR_CONFIG="${AIR_HOME}/air.conf"

# ── Help ────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
AIR — Indent Package Manager (pip for Indent)

Usage:
  air deps [dir]                   Auto-detect and install dependencies
  air install <name>[@version]     Install a package (auto-installs its deps)
  air install <name> <url>         Install from URL or local path
  air uninstall <name>             Remove a package
  air update [name]                Update one or all packages
  air search <query>               Search registry for packages
  air list                         List installed packages
  air info <name>                  Show package details
  air init                         Initialize a new Indent project

Examples:
  air deps                        # Scan current directory, install all deps
  air install colors               Install latest from registry
  air install math@2.5.0           Install specific version
  air install mypkg ./mypkg.ind    Install from local file
  air uninstall colors             Remove package
  air update                       Update all installed packages
  air update math                  Update specific package
  air search json                  Find json-related packages
  air list                         Show what's installed
  air info math                    Show package metadata

Deliveries (share a whole project as one bundle of packages):
  air delivery init                Scaffold an air-delivery.toml in this dir
  air delivery build [dir] [out]   Bundle a project into <name>-<ver>.dlv
  air delivery install <src>       Install a delivery (name | file | dir | url)
  air delivery publish <file> [registry]  Stage a .dlv into a registry checkout
  air delivery search <q>          Search the registry for deliveries
  air delivery list                List registry deliveries
  air delivery info <name>         Show a registry delivery
EOF
}

# ── Config ──────────────────────────────────────────────────────────
load_config() {
  mkdir -p "$AIR_HOME" "$AIR_PACKAGES" "$AIR_CACHE"
  if [[ -f "$AIR_CONFIG" ]]; then
    source "$AIR_CONFIG"
  fi
}

save_config() {
  mkdir -p "$(dirname "$AIR_CONFIG")"
  {
    echo "AIR_REGISTRY='${AIR_REGISTRY}'"
    echo "AIR_INDEX='${AIR_INDEX}'"
  } > "$AIR_CONFIG"
}

# ── Index ───────────────────────────────────────────────────────────
fetch_index() {
  local idx="$1"
  local cache_file="${AIR_CACHE}/index-$(echo "$idx" | sha256sum | cut -c1-16).txt"
  
  # Use cached index if less than 30 minutes old
  if [[ -f "$cache_file" ]] && [[ $(($(date +%s) - $(stat -c %Y "$cache_file"))) -lt 1800 ]]; then
    cat "$cache_file"
    return
  fi

  if [[ "$idx" =~ ^https?:// ]]; then
    if curl -fsSL --connect-timeout 5 --max-time 15 "$idx" -o "$cache_file" 2>/dev/null; then
      cat "$cache_file"
    else
      echo "⚠ Cannot reach registry: $idx" >&2
      return 1
    fi
  elif [[ -f "$idx" ]]; then
    cat "$idx"
  else
    echo "⚠ No registry index found" >&2
    return 1
  fi
}

resolve_package() {
  local name="$1"
  local index_data
  index_data="$(fetch_index "$AIR_INDEX")" || exit 1

  local line
  line="$(echo "$index_data" | awk -F'|' -v pkg="$name" '
    /^[[:space:]]*#/ { next }
    NF >= 2 {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
      if ($1 == pkg) { print; exit }
    }
  ')"

  if [[ -z "$line" ]]; then
    echo "✗ Package '$name' not found in registry" >&2
    exit 1
  fi

  echo "$line"
}

# ── Install ─────────────────────────────────────────────────────────
cmd_install() {
  load_config

  if [[ $# -lt 1 ]]; then
    echo "Usage: air install <name>[@version] [source]" >&2
    exit 1
  fi

  local raw="$1"
  local name="${raw%@*}"
  local ver="${raw##*@}"
  [[ "$ver" == "$raw" ]] && ver=""
  
  local source="${2:-}"
  
  # Resolve source if not explicitly given
  if [[ -z "$source" ]]; then
    local pkg_line
    pkg_line="$(resolve_package "$name")"
    source="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}')"
    local desc="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $4); print $4}')"
    
    # If name|source|sha256|description (4 fields), extract sha256
    local sha="$(echo "$pkg_line" | awk -F'|' 'NF>=4 {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); if ($3~/^[a-f0-9]{64}$/) print $3}')"
    
    # Make relative paths absolute
    if [[ ! "$source" =~ ^https?:// ]]; then
      source="${AIR_REGISTRY}/packages/${source#./}"
    fi
    
    echo "📦 Installing ${name}..."
    [[ -n "$desc" ]] && echo "   $desc"
    [[ -n "$ver" ]] && echo "   Version: $ver"
  else
    echo "📦 Installing ${name} from ${source}..."
  fi

  local target="${AIR_PACKAGES}/${name}.ind"
  
  # Download or copy
  if [[ "$source" =~ ^https?:// ]]; then
    if ! curl -fsSL --connect-timeout 10 --max-time 60 "$source" -o "$target"; then
      echo "✗ Failed to download: $source" >&2
      exit 1
    fi
  else
    if [[ ! -f "$source" ]]; then
      echo "✗ Source file not found: $source" >&2
      exit 1
    fi
    cp "$source" "$target"
  fi

  # Verify SHA256 if available
  local actual_sha
  actual_sha="$(sha256sum "$target" | awk '{print $1}')"
  if [[ -n "${sha:-}" ]] && [[ "$sha" != "$actual_sha" ]]; then
    echo "⚠ SHA256 mismatch! Expected: ${sha:0:16}... Got: ${actual_sha:0:16}..." >&2
    rm -f "$target"
    exit 1
  fi

  # Record in installed list
  local installed="${AIR_HOME}/installed.txt"
  touch "$installed"
  # Remove old entry
  grep -v "^${name}|" "$installed" > "${installed}.tmp" 2>/dev/null || true
  mv "${installed}.tmp" "$installed" 2>/dev/null || true
  echo "${name}|${source}|${actual_sha}|$(date -Iseconds)" >> "$installed"

  echo "✅ Installed ${name} → ${target}"

  # Auto-detect and install transitive dependencies
  auto_install_deps "$name"
}

# ── Uninstall ───────────────────────────────────────────────────────
cmd_uninstall() {
  load_config
  
  if [[ $# -lt 1 ]]; then
    echo "Usage: air uninstall <name>" >&2
    exit 1
  fi

  local name="$1"
  local target="${AIR_PACKAGES}/${name}.ind"

  if [[ -f "$target" ]]; then
    rm -f "$target"
    echo "🗑 Removed ${target}"
  else
    echo "⚠ Package '$name' not found at ${target}" >&2
  fi

  # Remove from installed list
  local installed="${AIR_HOME}/installed.txt"
  if [[ -f "$installed" ]]; then
    grep -v "^${name}|" "$installed" > "${installed}.tmp" 2>/dev/null || true
    mv "${installed}.tmp" "$installed" 2>/dev/null || true
  fi

  echo "✅ Uninstalled ${name}"
}

# ── Update ──────────────────────────────────────────────────────────
cmd_update() {
  load_config

  local installed="${AIR_HOME}/installed.txt"
  if [[ ! -f "$installed" ]]; then
    echo "No packages installed"
    return
  fi

  if [[ $# -eq 1 ]]; then
    # Update specific package
    local name="$1"
    local entry
    entry="$(grep "^${name}|" "$installed" 2>/dev/null || true)"
    if [[ -z "$entry" ]]; then
      echo "✗ Package '$name' is not installed" >&2
      exit 1
    fi
    local source="$(echo "$entry" | awk -F'|' '{print $2}')"
    echo "🔄 Updating ${name}..."
    cmd_install "$name" "$source"
  else
    # Update all
    echo "🔄 Updating all packages..."
    while IFS='|' read -r name source rest; do
      [[ -z "$name" ]] && continue
      echo "  Updating ${name}..."
      cmd_install "$name" "$source"
    done < "$installed"
  fi
}

# ── Search ──────────────────────────────────────────────────────────
cmd_search() {
  load_config
  
  if [[ $# -lt 1 ]]; then
    echo "Usage: air search <query>" >&2
    exit 1
  fi

  local query="$1"
  local index_data
  index_data="$(fetch_index "$AIR_INDEX")" || exit 1

  echo "🔍 Packages matching '$query':"
  echo ""
  
  local found=0
  while IFS='|' read -r name source sha desc; do
    # Skip header/comments
    [[ "$name" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$name" ]] && continue
    
    name="$(echo "$name" | xargs)"
    desc="$(echo "${desc:-}" | xargs)"
    source="$(echo "${source:-}" | xargs)"
    
    local search_text
    search_text="$(echo "${name} ${desc} ${source}" | tr '[:upper:]' '[:lower:]')"
    
    if [[ "$search_text" == *"$(echo "$query" | tr '[:upper:]' '[:lower:]')"* ]]; then
      printf "  %-20s %s\n" "$name" "$desc"
      found=$((found + 1))
    fi
  done <<< "$index_data"

  if [[ $found -eq 0 ]]; then
    echo "  (no results)"
  fi
  echo ""
}

# ── List ────────────────────────────────────────────────────────────
cmd_list() {
  load_config

  local installed="${AIR_HOME}/installed.txt"
  if [[ ! -f "$installed" ]] || [[ ! -s "$installed" ]]; then
    echo "No packages installed"
    echo ""
    echo "Install packages with: air install <name>"
    return
  fi

  echo "📦 Installed packages:"
  echo ""
  printf "  %-20s %-50s %s\n" "NAME" "SOURCE" "INSTALLED"
  printf "  %-20s %-50s %s\n" "----" "------" "---------"
  
  while IFS='|' read -r name source sha date; do
    [[ -z "$name" ]] && continue
    local short_source="${source:0:47}..."
    [[ ${#source} -le 50 ]] && short_source="$source"
    local short_date="${date:0:10}"
    printf "  %-20s %-50s %s\n" "$name" "$short_source" "$short_date"
  done < "$installed"
  echo ""
}

# ── Info ────────────────────────────────────────────────────────────
cmd_info() {
  load_config

  if [[ $# -lt 1 ]]; then
    echo "Usage: air info <name>" >&2
    exit 1
  fi

  local name="$1"
  local pkg_line
  pkg_line="$(resolve_package "$name")" || exit 1

  local source desc sha
  source="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}')"
  sha="$(echo "$pkg_line" | awk -F'|' 'NF>=4 {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); if ($3~/^[a-f0-9]{64}$/) print $3; else print "N/A"}')"
  desc="$(echo "$pkg_line" | awk -F'|' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $4); print $4}')"

  # Check if installed
  local installed="${AIR_HOME}/installed.txt"
  local status="not installed"
  local inst_date=""
  if [[ -f "$installed" ]]; then
    local entry
    entry="$(grep "^${name}|" "$installed" 2>/dev/null || true)"
    if [[ -n "$entry" ]]; then
      status="✓ installed"
      inst_date="$(echo "$entry" | awk -F'|' '{print $4}')"
    fi
  fi

  echo ""
  echo "📦 ${name}"
  echo "   Description: ${desc:-N/A}"
  echo "   Source:      ${source}"
  echo "   SHA256:      ${sha:-N/A}"
  echo "   Status:      ${status}"
  [[ -n "$inst_date" ]] && echo "   Installed:   ${inst_date:0:10}"
  echo ""
}

# ── Init ────────────────────────────────────────────────────────────
cmd_init() {
  if [[ -f "indent.toml" ]]; then
    echo "indent.toml already exists"
  else
    cat > indent.toml <<'EOF'
[package]
name = "my-project"
version = "0.1.0"

[dependencies]
EOF
    echo "✅ Created indent.toml"
  fi
  echo "Ready! Use 'air install <name>' to add dependencies."
}

# ── Dependency Detection ────────────────────────────────────────────
# Scans .ind files for 'get X from Y' imports and resolves Y to registry packages
scan_deps() {
  local dir="${1:-.}"
  local index_data
  index_data="$(fetch_index "$AIR_INDEX" 2>/dev/null || true)"

  echo "🔍 Scanning for dependencies in ${dir}..."
  echo ""

  local found=0
  local -A seen_pkgs  # bash associative array to avoid duplicates
  
  # Find all .ind files and scan for imports
  while IFS= read -r -d '' file; do
    while IFS= read -r line; do
      # Match: get X from Y  or  get X, Y from Z  or  import X from Y
      if [[ "$line" =~ (get|import)[[:space:]]+.+[[:space:]]+from[[:space:]]+([A-Za-z_][A-Za-z0-9_]*) ]]; then
        local module="${BASH_REMATCH[2]}"
        # Skip standard library modules (they ship with Indent)
        case "$module" in
          math|os|sys|time|random|json|http|strings|io|net|fs|testing|builtins|datetime|path)
            continue ;;
        esac
        # Check if already seen
        if [[ -n "${seen_pkgs[$module]:-}" ]]; then
          continue
        fi
        seen_pkgs[$module]=1
        
        # Check if already installed
        local installed="${AIR_HOME}/installed.txt"
        if [[ -f "$installed" ]] && grep -q "^${module}|" "$installed" 2>/dev/null; then
          echo "  ✅ ${module} (already installed)"
          found=$((found + 1))
          continue
        fi
        
        # Check if in registry
        if [[ -n "$index_data" ]] && echo "$index_data" | grep -q "^${module}|" 2>/dev/null; then
          echo "  📦 ${module} (in registry)"
          cmd_install "$module"
          found=$((found + 1))
        elif [[ -n "$index_data" ]] && echo "$index_data" | grep -q "^${module}\." 2>/dev/null; then
          echo "  📦 ${module} (in registry)"
          cmd_install "$module"  
          found=$((found + 1))
        else
          echo "  ⚠ ${module} (not found in registry — may be a local module)"
        fi
      fi
    done < "$file"
  done < <(find "$dir" -maxdepth 5 -name "*.ind" -print0 2>/dev/null)

  echo ""
  if [[ $found -eq 0 ]]; then
    echo "No external dependencies detected."
  else
    echo "✅ Processed ${found} dependencies."
  fi
}

cmd_deps() {
  load_config
  local dir="${1:-.}"
  scan_deps "$dir"
}

# ── Auto-deps on install ────────────────────────────────────────────
# After installing a package, scan its files for its own dependencies
auto_install_deps() {
  local pkg_name="$1"
  local pkg_dir="${AIR_PACKAGES}"
  local pkg_file="${pkg_dir}/${pkg_name}.ind"
  
  if [[ ! -f "$pkg_file" ]]; then
    return
  fi

  local index_data
  index_data="$(fetch_index "$AIR_INDEX" 2>/dev/null || true)"

  # Scan just the installed package file for its imports
  local -A seen
  while IFS= read -r line; do
    if [[ "$line" =~ (get|import)[[:space:]]+.+[[:space:]]+from[[:space:]]+([A-Za-z_][A-Za-z0-9_]*) ]]; then
      local dep="${BASH_REMATCH[2]}"
      case "$dep" in
        math|os|sys|time|random|json|http|strings|io|net|fs|testing|builtins|datetime|path) continue ;;
        "$pkg_name") continue ;;
      esac
      if [[ -n "${seen[$dep]:-}" ]]; then continue; fi
      seen[$dep]=1
      
      if [[ -z "$index_data" ]] || ! echo "$index_data" | grep -q "^${dep}|" 2>/dev/null; then
        continue
      fi
      
      local installed="${AIR_HOME}/installed.txt"
      if [[ -f "$installed" ]] && grep -q "^${dep}|" "$installed" 2>/dev/null; then
        continue
      fi
      
      echo "   └─ Auto-installing dependency: ${dep}"
      cmd_install "$dep" > /dev/null 2>&1 || true
    fi
  done < "$pkg_file"
}

# ═══════════════════════════════════════════════════════════════════
#  DELIVERIES — share a whole project as a bundle of packages
#
#  A "Delivery" packages an entire Indent project into ONE distributable
#  <name>-<version>.dlv archive (a .tar.gz). Inside it holds:
#    air-delivery.toml       the manifest (name/version/description)
#    modules/<import>.ind    module files -> each becomes an importable
#                            package once installed (get X from <import>)
#    entry/<file>            optional runnable entry point (kept local)
#    [dependencies]          registry packages pulled in automatically
#
#  So a module is a file, a package is an importable bundle of functions,
#  and a Delivery is a group of packages you can share/install as a unit.
# ═══════════════════════════════════════════════════════════════════

DLV_MANIFEST="air-delivery.toml"

# Read  key = "value"  under a TOML [section].
manifest_get() {
  local file="$1" section="$2" key="$3"
  awk -v sec="[$section]" -v key="$key" '
    /^[[:space:]]*\[/ { cur=$0; gsub(/[ \t]/,"",cur); next }
    cur==sec && $0 ~ "^[ \t]*"key"[ \t]*=" {
      sub(/^[ \t]*[^=]*=[ \t]*/, ""); gsub(/^"|"$/, ""); gsub(/[ \t]+$/,""); print; exit }
  ' "$file"
}

# Print every  key = value  line under a [section] as "key=value".
manifest_section() {
  local file="$1" section="$2"
  awk -v sec="[$section]" '
    /^[[:space:]]*\[/ { cur=$0; gsub(/[ \t]/,"",cur); next }
    cur==sec && /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*=/ {
      sub(/^[ \t]*/, ""); print }
  ' "$file"
}

cmd_delivery_init() {
  if [[ -f "$DLV_MANIFEST" ]]; then
    echo "air-delivery.toml already exists"
    return
  fi
  local default_name
  default_name="$(basename "$(pwd)")"
  cat > "$DLV_MANIFEST" <<EOF
# $DLV_MANIFEST — declares a Delivery (a whole project shared as one bundle)
# Build with:  air delivery build
[delivery]
name = "$default_name"
version = "0.1.0"
description = "An Indent project delivered as one unit"

# [entry] main = runnable entry point (optional; kept local, not imported)
[entry]

# [modules] <importName> = <path-to-.ind-file>
# Each becomes importable once the Delivery is installed:
#   get <Function> from <importName>
[modules]
# mylib = "src/mylib.ind"

# [dependencies] <registryPackage> = "version"
[dependencies]
EOF
  echo "✅ Created $DLV_MANIFEST — add module files under [modules], then:"
  echo "   air delivery build"
}

# Build a .dlv archive from a directory containing air-delivery.toml.
cmd_delivery_build() {
  local dir="${1:-.}"
  local out="${2:-$dir/dist}"
  local mf="$dir/$DLV_MANIFEST"
  if [[ ! -f "$mf" ]]; then
    echo "✗ No $DLV_MANIFEST in $dir (run 'air delivery init')" >&2
    exit 1
  fi

  local name ver desc
  name="$(manifest_get "$mf" delivery name)"
  ver="$(manifest_get "$mf" delivery version)"
  desc="$(manifest_get "$mf" delivery description)"
  if [[ -z "$name" ]]; then echo "✗ [delivery] name is required" >&2; exit 1; fi
  [[ -z "$ver" ]] && ver="0.0.0"

  # Validate module + entry files exist
  local missing=0 kv key path
  while IFS= read -r kv; do
    [[ -z "$kv" ]] && continue
    key="${kv%%=*}"; path="${kv#*=}"
    key="$(echo "$key" | xargs)"; path="$(echo "$path" | xargs)"
    [[ -z "$path" ]] && continue
    if [[ ! -f "$dir/$path" ]]; then
      echo "✗ module file not found: $path" >&2; missing=1
    fi
  done < <(manifest_section "$mf" modules)
  local entry_path
  entry_path="$(manifest_get "$mf" entry main)"
  if [[ -n "$entry_path" && ! -f "$dir/$entry_path" ]]; then
    echo "✗ entry not found: $entry_path" >&2; missing=1
  fi
  [[ $missing -eq 1 ]] && exit 1

  # Stage
  mkdir -p "$out"
  local stage="$out/$name-$ver"
  rm -rf "$stage"
  mkdir -p "$stage/modules" "$stage/entry"
  cp "$mf" "$stage/$DLV_MANIFEST"

  while IFS= read -r kv; do
    [[ -z "$kv" ]] && continue
    key="${kv%%=*}"; path="${kv#*=}"
    key="$(echo "$key" | xargs)"; path="$(echo "$path" | xargs)"
    [[ -z "$path" ]] && continue
    cp "$dir/$path" "$stage/modules/$key.ind"
  done < <(manifest_section "$mf" modules)

  if [[ -n "$entry_path" ]]; then
    cp "$dir/$entry_path" "$stage/entry/$(basename "$entry_path")"
  fi

  local tarball="$out/$name-$ver.dlv"
  ( cd "$out" && tar -czf "$(basename "$tarball")" "$name-$ver" )
  local sha; sha="$(sha256sum "$tarball" | awk '{print $1}')"

  echo "✅ Built delivery $name $ver"
  [[ -n "$desc" ]] && echo "   $desc"
  echo "   Archive: $tarball"
  echo "   SHA256:  $sha"
  echo "   Modules in this Delivery:"
  local modpath
  while IFS= read -r kv; do
    [[ -z "$kv" ]] && continue
    key="${kv%%=*}"; path="${kv#*=}"
    key="$(echo "$key" | xargs)"; path="$(echo "$path" | xargs)"
    [[ -z "$path" ]] && continue
    modpath="$(echo "$path" | sed 's#^\./##; s#.*/##')"
    echo "     • ${key}.ind  ←  $path"
  done < <(manifest_section "$mf" modules)
  rm -rf "$stage"
}

# Resolve a delivery source to a local .dlv archive path, echoing it.
delivery_resolve_archive() {
  local src="$1"
  if [[ -f "$src" && "$src" == *.dlv ]]; then
    echo "$src"; return 0
  fi
  if [[ -d "$src" && -f "$src/$DLV_MANIFEST" ]]; then
    # Build it on the fly into a temp out dir
    local tmpout
    tmpout="$(mktemp -d)"
    cmd_delivery_build "$src" "$tmpout" >/dev/null || return 1
    echo "$tmpout"/*.dlv
    return 0
  fi
  # Treat as a registry name
  local index_data line
  index_data="$(fetch_index "$AIR_DELIVERY_INDEX")" || exit 1
  line="$(echo "$index_data" | awk -F'|' -v n="$src" '
    /^[[:space:]]*#/ { next }
    { gsub(/^[ \t]+|[ \t]+$/, "", $1); if ($1==n) { print; exit } }')"
  if [[ -z "$line" ]]; then
    echo "✗ Delivery '$src' not found in registry" >&2; exit 1
  fi
  local rel sha
  rel="$(echo "$line" | awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}')"
  sha="$(echo "$line" | awk -F'|' 'NF>=3 {gsub(/^[ \t]+|[ \t]+$/, "", $3); print $3}')"
  # Index lives in deliveries/index.txt; archive sources are relative to the
  # deliveries/ dir (mirrors how packages resolve under packages/).
  local url="$rel"
  [[ "$url" =~ ^https?:// ]] || url="${AIR_REGISTRY}/deliveries/${rel#./}"
  if [[ "$url" =~ ^https?:// ]]; then
    local tmp; tmp="$(mktemp -d)"
    local arc="$tmp/$(basename "$url")"
    if ! curl -fsSL --connect-timeout 10 --max-time 120 "$url" -o "$arc"; then
      echo "✗ Failed to download delivery: $url" >&2; rm -rf "$tmp"; exit 1
    fi
    if [[ "$sha" =~ ^[a-f0-9]{64}$ ]]; then
      local got; got="$(sha256sum "$arc" | awk '{print $1}')"
      if [[ "$sha" != "$got" ]]; then
        echo "⚠ SHA256 mismatch for delivery" >&2; rm -rf "$tmp"; exit 1
      fi
    fi
    echo "$arc"
  else
    # Local registry path (e.g. AIR_REGISTRY points at a checkout)
    if [[ ! -f "$url" ]]; then
      echo "✗ Delivery archive not found: $url" >&2; exit 1
    fi
    echo "$url"
  fi
}

cmd_delivery_install() {
  load_config
  if [[ $# -lt 1 ]]; then
    echo "Usage: air delivery install <name|file.dlv|dir|url>" >&2; exit 1
  fi
  local src="$1"
  local arc
  arc="$(delivery_resolve_archive "$src")" || exit 1

  local tmp
  tmp="$(mktemp -d)"
  tar -xzf "$arc" -C "$tmp"
  # Locate the manifest inside (archive has a <name>-<ver>/ root folder)
  local mf name ver
  mf="$(find "$tmp" -maxdepth 2 -name "$DLV_MANIFEST" | head -n1)"
  if [[ -z "$mf" ]]; then
    echo "✗ Not a valid Delivery (no $DLV_MANIFEST inside)" >&2
    rm -rf "$tmp"; exit 1
  fi
  local root
  root="$(dirname "$mf")"
  name="$(manifest_get "$mf" delivery name)"
  ver="$(manifest_get "$mf" delivery version)"
  [[ -z "$ver" ]] && ver="0.0.0"
  echo "📦 Installing delivery ${name} ${ver}..."
  local desc
  desc="$(manifest_get "$mf" delivery description)"
  [[ -n "$desc" ]] && echo "   $desc"

  mkdir -p "$AIR_PACKAGES" "${AIR_HOME}/deliveries"

  # 1) Modules -> importable packages in air-packages
  local installed="${AIR_HOME}/installed.txt"
  touch "$installed"
  local modfile cnt=0
  for modfile in "$root"/modules/*.ind; do
    [[ -e "$modfile" ]] || continue
    local modname
    modname="$(basename "$modfile" .ind)"
    cp "$modfile" "$AIR_PACKAGES/$modname.ind"
    local modsha; modsha="$(sha256sum "$AIR_PACKAGES/$modname.ind" | awk '{print $1}')"
    grep -v "^${modname}|" "$installed" > "${installed}.tmp" 2>/dev/null || true
    mv "${installed}.tmp" "$installed" 2>/dev/null || true
    echo "${modname}|delivery:${name}@${ver}|${modsha}|$(date -Iseconds)" >> "$installed"
    echo "   • module ${modname} → ${AIR_PACKAGES}/${modname}.ind"
    cnt=$((cnt + 1))
  done
  if [[ $cnt -eq 0 ]]; then echo "   (no importable modules in this Delivery)"; fi

  # 2) Entry point (optional) kept local under deliveries/<name>-<ver>/
  local entry_path
  entry_path="$(manifest_get "$mf" entry main)"
  if [[ -n "$entry_path" ]]; then
    local appdir="${AIR_HOME}/deliveries/${name}-${ver}"
    mkdir -p "$appdir"
    cp "$root/entry/$(basename "$entry_path")" "$appdir/" 2>/dev/null || true
    echo "   • entry → ${appdir}/$(basename "$entry_path")"
  fi

  # 3) Dependencies
  local depkv depname
  while IFS= read -r depkv; do
    [[ -z "$depkv" ]] && continue
    depname="${depkv%%=*}"; depname="$(echo "$depname" | xargs)"
    if [[ -f "$installed" ]] && grep -q "^${depname}|" "$installed" 2>/dev/null; then
      echo "   • dep ${depname} (already installed)"
    else
      echo "   • installing dependency ${depname}..."
      cmd_install "$depname" || echo "   ⚠ could not install dependency ${depname}"
    fi
  done < <(manifest_section "$mf" dependencies)

  # Record delivery
  local dlv_file="${AIR_HOME}/deliveries.txt"
  touch "$dlv_file"
  grep -v "^${name}|" "$dlv_file" > "${dlv_file}.tmp" 2>/dev/null || true
  mv "${dlv_file}.tmp" "$dlv_file" 2>/dev/null || true
  echo "${name}|${ver}|$(date -Iseconds)" >> "$dlv_file"

  rm -rf "$tmp"
  echo "✅ Installed delivery ${name} ${ver}"
}

# Stage a built .dlv into a local registry checkout (then commit + push).
cmd_delivery_publish() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: air delivery publish <file.dlv> [registry-dir]" >&2; exit 1
  fi
  local arc="$1"
  if [[ ! -f "$arc" ]]; then echo "✗ Delivery file not found: $arc" >&2; exit 1; fi

  local reg="${2:-.}"
  local mf tmp name ver desc
  tmp="$(mktemp -d)"
  tar -xzf "$arc" -C "$tmp"
  mf="$(find "$tmp" -maxdepth 2 -name "$DLV_MANIFEST" | head -n1)"
  if [[ -z "$mf" ]]; then echo "✗ Not a valid Delivery archive" >&2; rm -rf "$tmp"; exit 1; fi
  name="$(manifest_get "$mf" delivery name)"
  ver="$(manifest_get "$mf" delivery version)"
  desc="$(manifest_get "$mf" delivery description)"
  rm -rf "$tmp"
  [[ -z "$name" || -z "$ver" ]] && { echo "✗ Delivery must declare name and version" >&2; exit 1; }

  local dlv_dir="$reg/deliveries"
  mkdir -p "$dlv_dir"
  local target="$dlv_dir/$name.dlv"
  cp "$arc" "$target"
  local sha; sha="$(sha256sum "$target" | awk '{print $1}')"

  local idx="$dlv_dir/index.txt"
  touch "$idx"
  grep -v "^${name}|" "$idx" > "${idx}.tmp" 2>/dev/null || true
  mv "${idx}.tmp" "$idx" 2>/dev/null || true
  echo "${name}|${name}.dlv|${sha}|${desc:-}" >> "$idx"

  echo "✅ Staged delivery ${name} ${ver}"
  echo "   ${target}"
  echo "   ${idx} updated"
  echo ""
  echo "To upload to the registry, commit and push from the registry repo:"
  echo "   cd ${reg}"
  echo "   git add deliveries && git commit -m \"delivery: add ${name} ${ver}\" && git push"
}

cmd_delivery_search() {
  load_config
  if [[ $# -lt 1 ]]; then echo "Usage: air delivery search <query>" >&2; exit 1; fi
  local q="$1"
  local index_data; index_data="$(fetch_index "$AIR_DELIVERY_INDEX")" || exit 1
  echo "🔍 Deliveries matching '$q':"
  local found=0 name src sha desc
  while IFS='|' read -r name src sha desc; do
    [[ "$name" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$name" ]] && continue
    local hay; hay="$(echo "${name} ${desc}" | tr '[:upper:]' '[:lower:]')"
    if [[ "$hay" == *"$(echo "$q" | tr '[:upper:]' '[:lower:]')"* ]]; then
      printf "  %-22s %s\n" "$name" "$desc"; found=$((found+1))
    fi
  done <<< "$index_data"
  [[ $found -eq 0 ]] && echo "  (no results)"
  echo ""
}

cmd_delivery_list() {
  load_config
  local index_data; index_data="$(fetch_index "$AIR_DELIVERY_INDEX")" || exit 1
  echo "📦 Registry deliveries:"
  local name src sha desc
  while IFS='|' read -r name src sha desc; do
    [[ "$name" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$name" ]] && continue
    printf "  %-22s %s\n" "$name" "$desc"
  done <<< "$index_data"
  echo ""
}

cmd_delivery_info() {
  load_config
  if [[ $# -lt 1 ]]; then echo "Usage: air delivery info <name>" >&2; exit 1; fi
  local q="$1"
  local index_data; index_data="$(fetch_index "$AIR_DELIVERY_INDEX")" || exit 1
  local line
  line="$(echo "$index_data" | awk -F'|' -v n="$q" '
    /^[[:space:]]*#/ { next }
    { gsub(/^[ \t]+|[ \t]+$/, "", $1); if ($1==n) { print; exit } }')"
  if [[ -z "$line" ]]; then echo "✗ Delivery '$q' not found in registry" >&2; exit 1; fi
  local name src sha desc
  name="$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/,"",$1); print $1}')"
  src="$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/,"",$2); print $2}')"
  sha="$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/,"",$3); print $3}')"
  desc="$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/,"",$4); print $4}')"
  echo ""
  echo "📦 ${name}"
  echo "   Description: ${desc:-N/A}"
  echo "   Archive:     ${src}"
  echo "   SHA256:      ${sha:-N/A}"
  echo ""
  echo "Install: air delivery install ${name}"
}

cmd_delivery() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: air delivery <init|build|install|publish|search|list|info>" >&2
    exit 1
  fi
  local sub="$1"; shift
  case "$sub" in
    init)            cmd_delivery_init "$@" ;;
    build)           cmd_delivery_build "$@" ;;
    install|add|i)   cmd_delivery_install "$@" ;;
    publish|push|up) cmd_delivery_publish "$@" ;;
    search|find|s)   cmd_delivery_search "$@" ;;
    list|ls)         cmd_delivery_list "$@" ;;
    info|show)       cmd_delivery_info "$@" ;;
    help|-h) echo "Usage: air delivery <init|build|install|publish|search|list|info>"; exit 0 ;;
    *) echo "Unknown delivery command: $sub" >&2; exit 1 ;;
  esac
}

# ── Main ────────────────────────────────────────────────────────────
main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    install|add|i)      cmd_install "$@" ;;
    uninstall|remove|rm) cmd_uninstall "$@" ;;
    update|upgrade|up)   cmd_update "$@" ;;
    search|find|s)       cmd_search "$@" ;;
    list|ls)             cmd_list "$@" ;;
    info|show)           cmd_info "$@" ;;
    deps)                cmd_deps "$@" ;;
    init)                cmd_init "$@" ;;
    delivery|deliver)    cmd_delivery "$@" ;;
    help|--help|-h)      usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      echo "Run 'air help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
