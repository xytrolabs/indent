#! Scaling probe for list append / list building.
fun build n
    var l dynamic = []
    repeat n
        l is append l 1
    give l

repeat trial in [5000, 10000, 20000, 40000]
    var t0 float = time_perf_counter
    var r dynamic = build trial
    var t1 float = time_perf_counter
    say "append x" + string(trial) + ": " + string(t1 - t0) + "s"

#! Preallocated-ish alternative: concat whole lists
fun build2 n
    var l dynamic = []
    repeat n
        l is l + [1]
    give l

repeat trial in [5000, 10000, 20000]
    var t0 float = time_perf_counter
    var r dynamic = build2 trial
    var t1 float = time_perf_counter
    say "l + [1] x" + string(trial) + ": " + string(t1 - t0) + "s"
