#! bench_concurrency.ind — the concurrency workload Phase 0 asks for: spawn 100
#! tasks and gather them, then the same work through `parallel`.
#!
#! This is the one benchmark whose cost depends on the machine's scheduler, so it is
#! also the one most likely to report noise. `check_baselines.py` takes the minimum
#! of N runs and compares N to N for exactly this reason; a genuine regression here
#! is one that survives several runs.

fun work x
    time_sleep 0.001
    give x * 2

var N int = 100

#! ---- spawn 100 handles, then wait for each ----
var t0 float = time_perf_counter
var ids dynamic = []
var i int = 0
while i < N
    ids is append ids (spawn "work" i)
    i += 1

var total int = 0
var j int = 0
while j < N
    total is total + (task_wait ids[j])
    j += 1
var t1 float = time_perf_counter
say "spawn+wait " + string(N) + ": " + string(t1 - t0) + "s"

#! ---- the same work through parallel (gather) ----
var args dynamic = []
var k int = 0
while k < N
    args is append args [k]
    k += 1

var t2 float = time_perf_counter
var results dynamic = parallel "work" args
var t3 float = time_perf_counter
say "parallel " + string(N) + ": " + string(t3 - t2) + "s"

#! ---- many sequential timer tasks: the allocation-per-task path ----
var t4 float = time_perf_counter
var m int = 0
while m < 200
    var h = spawn "work" m
    total is total + (task_wait h)
    m += 1
var t5 float = time_perf_counter
say "200 spawn+wait in sequence: " + string(t5 - t4) + "s"

say "checks " + string(len(results)) + " " + string(total)
