fun smallBody a
    give a

var N int = 20000

var t0 float = time_perf_counter
repeat N
    var r dynamic = smallBody 1
var t1 float = time_perf_counter
say "small body (2 stmts):  " + string((t1 - t0) * 1000000.0 / float(N)) + " us/call"

var t2 float = time_perf_counter
repeat N
    var r2 dynamic = bigBody 1
var t3 float = time_perf_counter
say "big body (302 stmts): " + string((t3 - t2) * 1000000.0 / float(N)) + " us/call"
