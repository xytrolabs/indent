#! bench_dict_heavy.ind — the dict/JSON shape Phase 0 asks for: parse → navigate →
#! serialise, on a payload with the shapes real payloads have (nested objects, a
#! list of rows, mixed value types, few keys per object).
#!
#! Labels are in the `label: <seconds>s` form that benchmarks/check_baselines.py
#! parses; anything starting with "checks" is ignored, so the final line is a
#! correctness guard rather than a measurement.

var N int = 2000

var row dynamic = {"id": 1, "name": "row", "ok": true, "score": 1.5, "tags": ["a", "b"]}
var rows dynamic = []
var i int = 0
while i < 20
    rows is append rows row
    i += 1

var payload dynamic = {"kind": "batch", "rows": rows, "meta": {"v": 1, "count": 20}}
var enc string = json_dumps payload
say "payload bytes: " + string(len(enc))

#! ---- parse + navigate ----
var t0 float = time_perf_counter
var acc int = 0
var j int = 0
while j < N
    var dec dynamic = json_loads enc
    acc is acc + len(dec["rows"])
    acc is acc + len(dec["meta"])
    j += 1
var t1 float = time_perf_counter
say "parse+navigate " + string(N) + ": " + string(t1 - t0) + "s"

#! ---- serialise ----
var t2 float = time_perf_counter
var k int = 0
while k < N
    var out string = json_dumps payload
    acc is acc + len(out)
    k += 1
var t3 float = time_perf_counter
say "serialise " + string(N) + ": " + string(t3 - t2) + "s"

#! ---- build and read a large dict directly (no JSON in the way) ----
var t4 float = time_perf_counter
var big dynamic = {}
var m int = 0
while m < 2000
    big["key" + string(m)] is m
    m += 1
var t5 float = time_perf_counter
say "insert 2000 keys: " + string(t5 - t4) + "s"

var t6 float = time_perf_counter
var hits int = 0
var n int = 0
while n < 2000
    hits is hits + (big["key" + string(n)])
    n += 1
var t7 float = time_perf_counter
say "lookup 2000 keys: " + string(t7 - t6) + "s"

say "checks " + string(len(big)) + " " + string(acc) + " " + string(hits)
