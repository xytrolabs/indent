#! Cost probe: `repeat <item> in <list>` and `repeat for <list>`.
#!
#! The iterable is built first with the in-place `append` path, then walked four
#! ways: summing the items, counting them, summing the indices (which is `Reps`,
#! so it checks the counter the loop publishes), and calling a function per item.
#! Expected: total 19999900000, count N, repsum 19999900000, acc 39999800000,
#! len N.

var N int = 200000
var xs dynamic = []
var i int = 0
repeat N
    xs is append xs i
    i is i + 1

var total int = 0
var t0 float = time_perf_counter
repeat v in xs
    total is total + v
var t1 float = time_perf_counter
say "for in sum    " + string((t1 - t0) * 1000000000.0 / float(N)) + " ns/op"

var count int = 0
var t2 float = time_perf_counter
repeat for xs
    count is count + 1
var t3 float = time_perf_counter
say "for each      " + string((t3 - t2) * 1000000000.0 / float(N)) + " ns/op"

#! ---- the index the loop publishes as Reps ----
var repsum int = 0
var t4 float = time_perf_counter
repeat v in xs
    repsum is repsum + Reps
var t5 float = time_perf_counter
say "for in reps   " + string((t5 - t4) * 1000000000.0 / float(N)) + " ns/op"

#! ---- a call per item, which also hands the loop's variables over ----
fun scaled n
    give n * 2

var acc int = 0
var t6 float = time_perf_counter
repeat v in xs
    acc is acc + scaled(v)
var t7 float = time_perf_counter
say "for in call   " + string((t7 - t6) * 1000000000.0 / float(N)) + " ns/op"

say "checks " + string(total) + " " + string(count) + " " + string(repsum) + " " + string(acc) + " " + string(len(xs))
