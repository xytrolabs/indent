#! Scaling probe for `xs is xs + [x]` list building.
#!
#! This is the list counterpart of bench_string_build.ind, and it measured the
#! same quadratic trap: `eval_binary`'s `(List, List)` arm extends a *clone* of
#! the left operand, so every step copied everything accumulated so far.
#!
#! A correct result: the per-step cost stays roughly flat as n doubles and the
#! total time doubles. If totals quadruple when n doubles, the quadratic
#! behaviour is back.
#!
#! Sizes are deliberately small: while quadratic, n=8000 already moves ~1.8 GB
#! of `Value`s, and larger sizes take minutes.
#!
#! Run:  indent benchmarks/bench_list_concat_build.ind

repeat n in [1000, 2000, 4000, 8000]
    var t0 float = time_perf_counter
    var xs dynamic = []
    repeat n
        xs is xs + [1]
    var t1 float = time_perf_counter
    var per float = (t1 - t0) * 1000000000.0 / float(n)
    say "build " + string(n) + ": " + string(t1 - t0) + "s total, " + string(per) + " ns/step, len " + string(len(xs))

#! The `+=` spelling of the same thing, which had the identical trap (it cloned
#! the list once in get_var and again inside eval_binary).
repeat n in [1000, 2000, 4000, 8000]
    var t0 float = time_perf_counter
    var ys dynamic = []
    repeat n
        ys += [1]
    var t1 float = time_perf_counter
    var per float = (t1 - t0) * 1000000000.0 / float(n)
    say "plus-eq " + string(n) + ": " + string(t1 - t0) + "s total, " + string(per) + " ns/step, len " + string(len(ys))

#! Building a group (set) the same way. This one is STILL QUADRATIC, and it is
#! here deliberately as a guard and a warning.
#!
#! eval_binary's set union formats both elements of every pair to compare them,
#! so one step is O(n) `format!` calls. The obvious fix — build a `HashSet` of
#! display keys once and insert — was tried and made it *worse* (measured:
#! 110891 ns/step vs 69815 at n=4000): the dedup set has to be rebuilt from the
#! whole set on every step, because the union starts from the left operand each
#! time, so it is still O(n) allocations per step and now hashes as well.
#! A real fix needs `Value::Set` to carry a hash index alongside its ordered
#! vector rather than being a plain `Vec`. Do not re-apply the HashSet version.
repeat n in [500, 1000, 2000, 4000]
    var t0 float = time_perf_counter
    var gs dynamic = group([])
    var i int = 0
    repeat n
        gs is gs + group([i])
        i is i + 1
    var t1 float = time_perf_counter
    var per float = (t1 - t0) * 1000000000.0 / float(n)
    say "group " + string(n) + ": " + string(t1 - t0) + "s total, " + string(per) + " ns/step, len " + string(len(gs))
