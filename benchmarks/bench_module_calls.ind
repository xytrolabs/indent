#! bench_module_calls.ind — what a module function call costs, next to a local one.
#!
#! Calling into a module used to inject that module's whole symbol table into the
#! caller's runtime for the duration of the call: one hash insert per exported name,
#! then a lookup and a restore per name afterwards. With the 41 functions in
#! `modcalls_fixture.ind` that came to 6.3 µs per call against 295 ns for the same
#! function defined locally — 21x — and the cost grew with the *module*, not with
#! the call. A function now runs in its module's scope instead, so the two should
#! cost the same.

get Work from modcalls_fixture
get Greets from modcalls_fixture

var N int = 20000

fun localWork x
    give x + 1

var t0 float = time_perf_counter
var acc int = 0
var i int = 0
while i < N
    acc is acc + localWork(i)
    i += 1
var t1 float = time_perf_counter
say "local call  " + string((t1 - t0) * 1000000000.0 / float(N)) + " ns/op"

var t2 float = time_perf_counter
var acc2 int = 0
var j int = 0
while j < N
    acc2 is acc2 + Work(j)
    j += 1
var t3 float = time_perf_counter
say "module call " + string((t3 - t2) * 1000000000.0 / float(N)) + " ns/op"

#! The same again, but the module function reads a module-level variable — that is
#! the part an injection scheme has to copy to get right.
var t4 float = time_perf_counter
var who string = ""
var k int = 0
while k < N
    who is Greets("there")
    k += 1
var t5 float = time_perf_counter
say "module state " + string((t5 - t4) * 1000000000.0 / float(N)) + " ns/op"

say "checks " + string(acc) + " " + string(acc2) + " " + who
