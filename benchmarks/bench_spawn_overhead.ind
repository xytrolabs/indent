#! bench_spawn_overhead.ind — what a `spawn` costs before the spawned body does
#! anything at all.
#!
#! Spawning used to clone the program's whole function table, callable table, class
#! table and async-name set into the new runtime: four maps rebuilt per task, sized
#! by the *program*, not by the task. This benchmark makes that cost visible by
#! defining enough functions that the tables are worth copying, and then spawning a
#! function that returns immediately — so the time measured is the hand-over.

fun trivial x
    give x

#! Filler functions: each one is an entry in the table a spawn has to copy.
fun filler01 x
    give x
fun filler02 x
    give x
fun filler03 x
    give x
fun filler04 x
    give x
fun filler05 x
    give x
fun filler06 x
    give x
fun filler07 x
    give x
fun filler08 x
    give x
fun filler09 x
    give x
fun filler10 x
    give x
fun filler11 x
    give x
fun filler12 x
    give x
fun filler13 x
    give x
fun filler14 x
    give x
fun filler15 x
    give x
fun filler16 x
    give x
fun filler17 x
    give x
fun filler18 x
    give x
fun filler19 x
    give x
fun filler20 x
    give x

var N int = 300

#! ---- spawn and immediately wait, one at a time ----
var t0 float = time_perf_counter
var i int = 0
while i < N
    var id dynamic = spawn "trivial" i
    var got dynamic = task_wait id
    i += 1
var t1 float = time_perf_counter
say "spawn+wait " + string(N) + " (ns/op) " + string((t1 - t0) * 1000000000.0 / float(N)) + " ns/op"

#! ---- the same through `future` ----
var t2 float = time_perf_counter
var j int = 0
while j < N
    var fid dynamic = future "trivial" j
    var fgot dynamic = task_wait fid
    j += 1
var t3 float = time_perf_counter
say "future+wait " + string(N) + " (ns/op) " + string((t3 - t2) * 1000000000.0 / float(N)) + " ns/op"

say "checks " + string(N)
