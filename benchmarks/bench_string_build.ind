#! Scaling probe for `s is s + x` string building.
#!
#! This is the idiomatic way to build a string in a loop, and it used to be
#! quadratic: every step went through `eval_binary`'s `(Str, y)` arm, which is
#! `format!("{}{}", s, x)` — a brand-new `String` holding everything accumulated
#! so far — so building an n-character string copied O(n²) bytes.
#!
#! A correct result looks like this: the per-iteration cost stays roughly FLAT
#! as n doubles, and the total time doubles. If the totals quadruple when n
#! doubles, the quadratic behaviour is back.
#!
#! Run:  indent benchmarks/bench_string_build.ind

repeat n in [10000, 20000, 40000, 80000]
    var t0 float = time_perf_counter
    var s string = ""
    repeat n
        s is s + "x"
    var t1 float = time_perf_counter
    var per float = (t1 - t0) * 1000000000.0 / float(n)
    say "build " + string(n) + ": " + string(t1 - t0) + "s total, " + string(per) + " ns/step, len " + string(len(s))
