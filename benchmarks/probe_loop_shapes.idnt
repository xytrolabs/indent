#! Probe: which loop SHAPES were affected by the method-dispatch change?
#!
#! A global (code-layout) regression slows every shape by a similar factor.
#! A path-specific regression slows only the shapes that touch the changed code.
#! Every section is the same `repeat` with a one-statement body, so the loop
#! machinery itself is held constant and only the body's cost varies.

fun one
    give 1

var N int = 200000
var x int = 0
var y int = 7
var word string = "hello"
var xs dynamic = [1, 2, 3, 4, 5]
var s string = ""
var b boolean = TRUE
var one_val int = 1

var t0 float = time_perf_counter
repeat N
    s is word
var t1 float = time_perf_counter
say "copy string    " + string((t1 - t0) * 1000000000.0 / float(N)) + " ns/op"

var t2 float = time_perf_counter
repeat N
    x is y
var t3 float = time_perf_counter
say "copy int       " + string((t3 - t2) * 1000000000.0 / float(N)) + " ns/op"

var t4 float = time_perf_counter
repeat N
    x is x + 1
var t5 float = time_perf_counter
say "int add        " + string((t5 - t4) * 1000000000.0 / float(N)) + " ns/op"

var t6 float = time_perf_counter
repeat N
    b is not b
var t7 float = time_perf_counter
say "not bool       " + string((t7 - t6) * 1000000000.0 / float(N)) + " ns/op"

var t8 float = time_perf_counter
repeat N
    x is y == one_val
var t9 float = time_perf_counter
say "int equals     " + string((t9 - t8) * 1000000000.0 / float(N)) + " ns/op"

var t10 float = time_perf_counter
repeat N
    x is len(xs)
var t11 float = time_perf_counter
say "len builtin    " + string((t11 - t10) * 1000000000.0 / float(N)) + " ns/op"

var t12 float = time_perf_counter
repeat N
    x is one()
var t13 float = time_perf_counter
say "user call      " + string((t13 - t12) * 1000000000.0 / float(N)) + " ns/op"

say "checks " + string(x) + " " + string(len(s)) + " " + string(b)
