#! method_calls.ind — 100 000 object method calls, plus a wide-field class.
#!
#! The path this stresses is per-call dispatch: a temporary runtime is built, the
#! class's fields are inserted into it by name, the body runs, and the fields are
#! read back out. 100 000 iterations is the interpreter's own `LOOP_MAX_ITERS`
#! ceiling, so this is the longest single loop the language allows.

class Tally
    var n int

    fun bump
        n is n + 1
        give n

    fun to_string
        give "Tally(" + string(n) + ")"

class Wide
    var a int
    var b int
    var c int
    var d int
    var e int
    var f int
    var g int
    var h int

    fun sum_fields extra
        give a + b + c + d + e + f + g + h + extra

var c dynamic = Tally(0)
var i int = 0
while i < 100000
    c.bump
    i is i + 1
say "calls " + string(c.n)

#! Special-method dispatch (`to_string`), which walks the method table.
var text string = ""
var j int = 0
while j < 20000
    text is string(c)
    j is j + 1
say "to_string " + string(len(text))

var w dynamic = Wide(1, 2, 3, 4, 5, 6, 7, 8)
var acc int = 0
var k int = 0
while k < 50000
    #! An argument is required here: a zero-argument method written as a dotted
    #! name *inside an expression* is resolved as a field read and fails with
    #! "Object has no field", at statement level it dispatches. That is engine
    #! behaviour on both paths, not a VM divergence, and it is reported upstream
    #! rather than pinned here.
    acc is acc + w.sum_fields 0
    k is k + 1
say "wide " + string(acc)

#! A wide method table: the lookup has to find the *last* declared method, which is
#! the worst case for a scan and the best case for a hash hit.
class Many
    var v int

    fun m01 extra
        give v + 1 + extra

    fun m02 extra
        give v + 2 + extra

    fun m03 extra
        give v + 3 + extra

    fun m04 extra
        give v + 4 + extra

    fun m05 extra
        give v + 5 + extra

    fun m06 extra
        give v + 6 + extra

    fun m07 extra
        give v + 7 + extra

    fun m08 extra
        give v + 8 + extra

    fun m09 extra
        give v + 9 + extra

    fun m10 extra
        give v + 10 + extra

    fun m11 extra
        give v + 11 + extra

    fun m12 extra
        give v + 12 + extra

var many dynamic = Many(0)
var wide_total int = 0
var q int = 0
while q < 50000
    wide_total is wide_total + many.m12 0
    q is q + 1
say "many " + string(wide_total)
