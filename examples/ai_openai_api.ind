#! Call a real OpenAI-compatible API (like OpenAI or a local Ollama /v1 server).
#!
#! Same package, two targets — just SetBase + (optionally) SetApiKey:
#!   1. Local Ollama (default):  SetBase("http://localhost:11434/v1")  — no key
#!   2. Real OpenAI:             SetBase("https://api.openai.com/v1")
#!                               SetApiKey("sk-...")   # from platform.openai.com
#!
#! Under the hood ai.ind uses Indent's native http_post_json / http_get builtins
#! (which return {"ok","status","body"}); you can call ANY REST API the same way.

get ai as AI

#! --- Target 1: local Ollama (no key) ---
say "=== Local Ollama (/v1, no key) ==="
say "base: " + string(AI.GetBase())
var reply = AI.Chat("qwen2.5:0.5b", [{"role":"user","content":"What is 2+2? One word."}])
say "reply: " + string(reply)

#! --- Target 2: real OpenAI (uncomment + add your key) ---
#! AI.SetBase("https://api.openai.com/v1")
#! AI.SetApiKey("sk-REPLACE_WITH_YOUR_KEY")
#! var gpt = AI.Chat("gpt-4o-mini", [{"role":"user","content":"Say hello in 3 words"}])
#! say "gpt: " + string(gpt)

#! --- Raw builtin call to ANY API (the low-level way) ---
#! Every http_* builtin returns {"ok": bool, "status": int, "body": "<json string>"}
say ""
say "=== Raw REST call (any API) ==="
var payload = {"model": "qwen2.5:0.5b", "messages": [{"role": "user", "content": "What is the capital of France?"}]}
var resp = http_post_json("http://localhost:11434/v1/chat/completions", payload, "")
say "ok=" + string(resp["ok"]) + " status=" + string(resp["status"])
var data = json_loads(resp["body"])
say "answer: " + string(data["choices"][0]["message"]["content"])
say ""
say "Other builtins: http_get(url, auth), http_put_json, http_patch_json, http_delete"
say "For GET:  var r = http_get(url)                     # body is the raw text"
say "For auth: http_post_json(url, payload, \"Bearer sk-...\")"
say "API DEMO COMPLETE"
