#! AI package demo — Python openai-style SDK in Indent
#! Requires: air install ai  +  local Ollama running.
get ai as AI

say "=== 1. Models ==="
repeat m in AI.Models()
    say "  " + string(m)

say "=== 2. Chat (chat.completions) ==="
var reply = AI.Chat("qwen2.5:0.5b", [{"role":"user","content":"What is 7*8? Answer in one word."}])
say "  7*8 = " + string(reply)

say "=== 3. Ask (completions) ==="
say "  " + string(AI.Ask("qwen2.5:0.5b", "Name one ocean."))

say "=== 4. Embed + Similarity ==="
var v1 = AI.Embed("nomic-embed-text", "I love programming")
var v2 = AI.Embed("nomic-embed-text", "Coding is fun")
var v3 = AI.Embed("nomic-embed-text", "I enjoy pizza")
say "  sim(programming, coding) = " + string(AI.Similarity(v1, v2))
say "  sim(programming, pizza)  = " + string(AI.Similarity(v1, v3))

say "=== 5. Semantic Search ==="
var docs = []
docs is docs + ["Python is a programming language"]
docs is docs + ["Rust is a systems programming language"]
docs is docs + ["Indent is an indentation-based language"]
docs is docs + ["Cats are small pets"]
var ranked = AI.Search("coding languages", docs)
repeat pair in ranked
    say "  " + string(pair[0]) + "  " + string(pair[1])
say "AI PACKAGE DEMO COMPLETE"
