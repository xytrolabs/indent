#! Indent Breakout — a complete game written 100% in Indent using InGame.
#!
#! Demonstrates that Indent handles all game programming: game objects, physics,
#! collision, scoring, rendering, input. Uses the PyGame-mirroring API:
#!   SetMode / DrawRect / DrawCircle / DrawLine / DrawText / Flip / GetEvents / Quit
#!
#! Controls: arrow keys. Close window to quit.
#! Auto-bot: set INDENT_BREAKOUT_BOT=1 to play itself (headless verification).
get Init from ingame as IgInit
get SetMode from ingame as IgSetMode
get DrawRect from ingame as IgRect
get DrawCircle from ingame as IgCircle
get DrawLine from ingame as IgLine
get DrawText from ingame as IgText
get Flip from ingame as IgFlip
get GetEvents from ingame as IgEvents
get Quit from ingame as IgQuit

#! --- Config ---
var W = 500
var H = 400
var PADDLE_W = 70
var PADDLE_H = 10
var BALL_R = 6

#! --- State ---
var paddleX = (W - PADDLE_W) / 2
var bx = W / 2
var by = H - 60
var bvx = 2.5
var bvy = -2.5
var score = 0
var lives = 3
var running = true
var frames = 0
var maxFrames = 300
var BOT = false
var botEnv = os_getenv("INDENT_BREAKOUT_BOT", "")
if botEnv == "1"
    BOT is true

#! --- Bricks: list of dicts {x, y, w, h, alive} ---
var bricks = []
var bx2 = 20
repeat while bx2 < W - 20
    var by2 = 30
    repeat while by2 < 90
        bricks is bricks + [{"x": bx2, "y": by2, "w": 40, "h": 14, "alive": true}]
        by2 is by2 + 18
    bx2 is bx2 + 46

#! --- Brick collision: returns hit or not, sets brick dead ---
fun BallHitsBrick
    var i = 0
    repeat while i < len(bricks)
        var b = bricks[i]
        if b["alive"]
            if bx + BALL_R > b["x"] and bx - BALL_R < b["x"] + b["w"]
                if by + BALL_R > b["y"] and by - BALL_R < b["y"] + b["h"]
                    bvy is -bvy
                    b["alive"] is false
                    bricks[i] is b
                    score is score + 10
                    give true
        i is i + 1
    give false

say "=== Breakout (100% Indent) ==="
IgInit()
var screen = IgSetMode(W, H, "Indent Breakout — InGame")

repeat while running and frames < maxFrames
    #! --- Input ---
    var evts = IgEvents()
    repeat e in evts
        if e["type"] == "quit"
            running is false
        if e["type"] == "keydown"
            if e["key"] == "ArrowLeft"
                paddleX is paddleX - 25
            if e["key"] == "ArrowRight"
                paddleX is paddleX + 25

    #! Bot: track ball
    if BOT
        if bx > paddleX + PADDLE_W / 2
            paddleX is paddleX + 3
        if bx < paddleX + PADDLE_W / 2
            paddleX is paddleX - 3

    #! Clamp paddle
    if paddleX < 0
        paddleX is 0
    if paddleX > W - PADDLE_W
        paddleX is W - PADDLE_W

    #! --- Physics ---
    bx is bx + bvx
    by is by + bvy

    #! Walls
    if bx < BALL_R or bx > W - BALL_R
        bvx is -bvx
    if by < BALL_R
        bvy is -bvy

    #! Paddle
    if bvy > 0 and by + BALL_R > H - PADDLE_H - 4 and bx > paddleX and bx < paddleX + PADDLE_W
        bvy is -bvy

    #! Bricks
    BallHitsBrick()

    #! Lose ball
    if by > H
        lives is lives - 1
        bx is W / 2
        by is H - 60
        bvy is -bvy
        if lives <= 0
            running is false

    #! --- Draw ---
    #! Walls
    IgLine(0, 0, W, 0, "#30363d", 2)
    IgLine(0, 0, 0, H, "#30363d", 2)
    IgLine(W, 0, W, H, "#30363d", 2)

    #! Paddle
    IgRect(paddleX, H - PADDLE_H, PADDLE_W, PADDLE_H, "#58a6ff")

    #! Ball
    IgCircle(bx, by, BALL_R, "#f85149")

    #! Bricks
    repeat b in bricks
        if b["alive"]
            IgRect(b["x"], b["y"], b["w"], b["h"], "#39d353")

    #! HUD
    IgText(8, H - 14, "Score: " + string(score) + "  Lives: " + string(lives), "#ffffff", 14)
    IgText(8, 12, "Frame: " + string(frames), "#8b949e", 11)

    IgFlip("#0d1117")

    frames is frames + 1
    time_sleep 0.016

say "Completed " + string(frames) + " frames, score " + string(score) + ", lives " + string(lives)
IgQuit()
say "BREAKOUT COMPLETE"
