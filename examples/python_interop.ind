say "=== Python interop tests ==="
say "python_available: " + string(python_available())

var simple = python_eval("1 + 2 * 3")
say "eval '1+2*3' = " + string(simple)

var mathVal = python_eval("__import__('math').sqrt(16)")
say "eval sqrt(16) = " + string(mathVal)

var listJson = python_eval_json("[x*x for x in range(5)]")
say "eval_json squares = " + string(listJson)
say "type: " + type_of(listJson)
say "item 2: " + string(listJson[2])

var dictJson = python_eval_json("{'name': 'Ada', 'age': 36}")
say "eval_json dict = " + string(dictJson)
say "age: " + string(dictJson["age"])
