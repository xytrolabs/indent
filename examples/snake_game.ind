#! Indent Snake — 100% game logic in Indent using the InGame framework.
#!
#! This is PyGame-style: ALL movement, collision, scoring, and rendering logic
#! is written in Indent. A native window (indent-ingame) just renders the frames
#! and reports keyboard input.
#!
#! Controls: arrow keys. Space not needed (auto-advance). Close window to quit.
#! Auto-bot: add "bot" arg region to make it play itself (for headless testing).
get Init from ingame as IgInit
get Clear from ingame as IgClear
get Rect from ingame as IgRect
get Circle from ingame as IgCircle
get Text from ingame as IgText
get Present from ingame as IgPresent
get Events from ingame as IgEvents
get Quit from ingame as IgQuit

#! --- Config ---
var GRID = 20
var CELL = 20
var W = GRID * CELL   #! 400
var H = GRID * CELL   #! 400
var FRAME_SLEEP = 0.08

#! --- Game state ---
var snake = [[10, 10], [9, 10], [8, 10]]
var dir = [1, 0]          #! [dx, dy]
var food = [15, 10]
var score = 0
var running = true
var gameOver = false
var frames = 0
var ateThisFrame = false

#! --- Random food placement (avoid the snake) ---
fun PlaceFood
    var ok = false
    repeat while not ok
        var fx = random_int(0, GRID - 1)
        var fy = random_int(0, GRID - 1)
        var blocked = false
        repeat seg in snake
            if seg[0] == fx and seg[1] == fy
                blocked is true
        if not blocked
            food is [fx, fy]
            ok is true

#! --- Bot: greedy safe steering toward food (avoids walls/self) ---
fun BotSteer
    var head = snake[0]
    var candidates = [[1, 0], [-1, 0], [0, 1], [0, -1]]
    var best = dir
    var bestDist = 100000
    repeat c in candidates
        var nx = head[0] + c[0]
        var ny = head[1] + c[1]
        if nx < 0 or nx >= GRID or ny < 0 or ny >= GRID
            next
        var blocked = false
        repeat seg in snake
            if seg[0] == nx and seg[1] == ny
                blocked is true
        if blocked
            next
        var dx = food[0] - nx
        var dy = food[1] - ny
        var dist = dx * dx + dy * dy
        if dist < bestDist
            bestDist is dist
            best is c
    dir is best

#! --- One simulation step ---
fun Step
    var head = snake[0]
    var newHead = [head[0] + dir[0], head[1] + dir[1]]

    #! Wall collision
    if newHead[0] < 0 or newHead[0] >= GRID or newHead[1] < 0 or newHead[1] >= GRID
        gameOver is true
        give empty

    #! Self collision
    repeat seg in snake
        if seg[0] == newHead[0] and seg[1] == newHead[1]
            gameOver is true

    if gameOver
        give empty

    #! Move: prepend new head
    snake is [[newHead[0], newHead[1]]] + snake

    #! Eat?
    if newHead[0] == food[0] and newHead[1] == food[1]
        score is score + 10
        PlaceFood()
    otherwise
        snake is slice(snake, 0, len(snake) - 1)

#! --- Main ---
say "🐍 Indent Snake (InGame) — all logic in Indent"
var BOT = false
var botEnv = os_getenv("INDENT_SNAKE_BOT", "")
if botEnv == "1"
    BOT is true
    say "BOT MODE: auto-playing (INDENT_SNAKE_BOT=1)"
var win = IgInit(W, H, "Indent Snake — InGame")
PlaceFood()

repeat while running
    #! --- Input ---
    var evts = IgEvents()
    repeat e in evts
        if e["type"] == "quit"
            running is false
        if e["type"] == "key" and has_key(e, "down") and e["down"] == true
            if e["key"] == "ArrowUp" and dir[1] != 1
                dir is [0, -1]
            if e["key"] == "ArrowDown" and dir[1] != -1
                dir is [0, 1]
            if e["key"] == "ArrowLeft" and dir[0] != 1
                dir is [-1, 0]
            if e["key"] == "ArrowRight" and dir[0] != -1
                dir is [1, 0]

    if not running
        stop

    #! Bot mode: auto-steer toward food
    if BOT
        BotSteer()

    #! --- Update ---
    Step()

    #! --- Draw ---
    IgClear("#0d1117")

    #! Grid (subtle)
    var gx = 0
    repeat while gx < GRID
        var gy = 0
        repeat while gy < GRID
            if (gx + gy) % 2 == 0
                IgRect(gx * CELL, gy * CELL, CELL, CELL, "#131a22")
            gy is gy + 1
        gx is gx + 1

    #! Food (red circle)
    IgCircle(food[0] * CELL + CELL / 2, food[1] * CELL + CELL / 2, CELL / 2 - 2, "#f85149")

    #! Snake (green)
    var idx = 0
    repeat seg in snake
        if idx == 0
            IgRect(seg[0] * CELL + 1, seg[1] * CELL + 1, CELL - 2, CELL - 2, "#39d353")
        otherwise
            IgRect(seg[0] * CELL + 1, seg[1] * CELL + 1, CELL - 2, CELL - 2, "#26a641")
        idx is idx + 1

    #! HUD
    IgText(6, 18, "Score: " + string(score), "#ffffff", 14)
    IgText(6, H - 8, "Frames: " + string(frames), "#8b949e", 11)

    if gameOver
        IgText(W / 2 - 60, H / 2, "GAME OVER", "#f85149", 22)
        IgText(W / 2 - 90, H / 2 + 24, "Score: " + string(score), "#ffffff", 14)

    IgPresent("#0d1117")

    frames is frames + 1
    time_sleep FRAME_SLEEP

    #! Auto-restart after game over so it can run indefinitely
    if gameOver and frames % 1 == 0
        time_sleep 1.0
        snake is [[10, 10], [9, 10], [8, 10]]
        dir is [1, 0]
        score is 0
        gameOver is false
        PlaceFood()

IgQuit()
say "Snake finished after " + string(frames) + " frames"
