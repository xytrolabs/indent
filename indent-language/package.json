{
  "name": "indent-support",
  "displayName": "Indent Language Support by Xytro Labs",
  "description": "Language support for Indent (.ind, .glo) — syntax highlighting, snippets, debugging, dark theme",
  "version": "1.0.0",
  "publisher": "xytro-labs",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:indent",
    "onCommand:indent.newProject",
    "onCommand:indent.configureWorkspace",
    "onCommand:indent.runCurrentFile",
    "onCommand:indent.debugCurrentFile",
    "onDebugInitialConfigurations",
    "onDebugResolve:indent"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "indent",
        "aliases": [
          "Indent",
          "indent"
        ],
        "extensions": [
          ".ind",
          ".glo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "indent",
        "scopeName": "source.indent",
        "path": "./syntaxes/indent.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Indent Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/indent-dark.json"
      }
    ],
    "snippets": [
      {
        "language": "indent",
        "path": "./snippets/indent.json"
      }
    ],
    "commands": [
      {
        "command": "indent.newProject",
        "title": "Indent: New Project",
        "category": "Indent"
      },
      {
        "command": "indent.configureWorkspace",
        "title": "Indent: Configure Run/Debug For Workspace",
        "category": "Indent"
      },
      {
        "command": "indent.runCurrentFile",
        "title": "Indent: Run Current File",
        "category": "Indent"
      },
      {
        "command": "indent.debugCurrentFile",
        "title": "Indent: Debug Current File",
        "category": "Indent"
      }
    ],
    "debuggers": [
      {
        "type": "indent",
        "label": "Indent",
        "languages": [
          "indent"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "request",
              "type"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .ind file to run"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debug run"
              },
              "debug": {
                "type": "boolean",
                "default": true,
                "description": "Whether to run with --debug"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Debug Current Indent File",
            "type": "indent",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "debug": true
          },
          {
            "name": "Run Current Indent File",
            "type": "indent",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "debug": false
          }
        ]
      }
    ]
  }
}
