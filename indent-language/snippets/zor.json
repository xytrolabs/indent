{
  "fun": {
    "prefix": "fun",
    "body": [
      "fun ${1:name}(${2:params}) {",
      "\t${3}",
      "}"
    ],
    "description": "Zor function"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:fields}",
      "}"
    ],
    "description": "Zor struct"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:variants}",
      "}"
    ],
    "description": "Zor enum"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "\t${2}",
      "}"
    ],
    "description": "Zor impl block"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "}"
    ],
    "description": "Zor if statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} otherwise {",
      "\t${3}",
      "}"
    ],
    "description": "Zor if/otherwise statement"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} -> ${3:result}",
      "}"
    ],
    "description": "Zor match expression"
  },
  "repeat": {
    "prefix": "repeat",
    "body": [
      "repeat {",
      "\t${1}",
      "}"
    ],
    "description": "Zor repeat loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${2}",
      "}"
    ],
    "description": "Zor while loop"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t${3}",
      "}"
    ],
    "description": "Zor for-in loop"
  },
  "give": {
    "prefix": "give",
    "body": "give ${1:expression}",
    "description": "Zor return statement"
  },
  "say": {
    "prefix": "say",
    "body": "say(${1:expression})",
    "description": "Zor print statement"
  },
  "var": {
    "prefix": "var",
    "body": "var ${1:name}: ${2:type} = ${3:value}",
    "description": "Zor variable declaration"
  },
  "mut": {
    "prefix": "mut",
    "body": "mut ${1:name}: ${2:type} = ${3:value}",
    "description": "Zor mutable variable"
  },
  "use": {
    "prefix": "use",
    "body": "use ${1:module}",
    "description": "Zor import"
  }
}
