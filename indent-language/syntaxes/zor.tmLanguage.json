{
  "name": "Zor",
  "scopeName": "source.zor",
  "fileTypes": ["zor"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.zor", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zor",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.zor", "match": "\\\\." },
            { "name": "variable.interpolation.zor", "match": "%[a-zA-Z_][a-zA-Z0-9_]*%" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.zor", "match": "\\b(fun|give|say|if|or|otherwise|repeat|while|in|stop|next|match|get|from|new|free|sizeof|len|null|struct|enum|impl|use|as|var|mut)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.zor", "match": "\\b(int|float|string|bool|char|void)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.zor", "match": "\\b(true|false|empty)\\b" },
        { "name": "constant.numeric.zor", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.zor", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.zor", "match": "=>|->|==|!=|<=|>=|&&|\\|\\||[+\\-*/%=<>!&|.:;(){}\\[\\],]" }
      ]
    }
  }
}
