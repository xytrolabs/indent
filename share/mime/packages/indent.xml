<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-indent">
    <comment>Indent source file</comment>
    <acronym>Indent</acronym>
    <expanded-acronym>Indent</expanded-acronym>
    <!-- `.idnt` is the current spelling. The two below are the extensions it had
         before, kept so an existing project still gets the Indent icon and opens in
         Indent; the interpreter accepts all three (INDENT_SOURCE_EXTS). -->
    <glob pattern="*.idnt"/>
    <glob pattern="*.ath"/>
    <glob pattern="*.ind"/>
  </mime-type>
  <mime-type type="text/x-indent-env">
    <comment>Indent environment file</comment>
    <glob pattern="*.glo"/>
  </mime-type>
</mime-info>
