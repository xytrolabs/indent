#! =============================================================================
#! ai.ind 1.0 — The Indent AI assistant package (like Python's `openai` SDK)
#! =============================================================================
#!
#! A clean client for local AI servers (Ollama by default). Mirror of the
#! OpenAI Python SDK surface, adapted for Indent:
#!   Chat    → openai client.chat.completions.create
#!   Ask     → openai client.completions.create (single prompt)
#!   Embed   → openai client.embeddings.create (single input)
#!   EmbedMany → openai client.embeddings.create (batch input)
#!   Models  → openai client.models.list
#!   Similarity → cosine similarity between two embeddings
#!   Search  → semantic search: rank docs by similarity to a query
#!   SetBase / SetDefaultModel / SetDefaultEmbedModel → client config
#!
#! Two import styles:
#!   get ai as AI
#!   var reply = AI.Chat("qwen2.5:0.5b", [{"role":"user","content":"hi"}])
#!
#!   get Chat from ai
#!   var reply = Chat("qwen2.5:0.5b", [{"role":"user","content":"hi"}])
#!
#! Requires a local Ollama server (default http://localhost:11434).
#! Models: qwen2.5:0.5b (chat/generate), nomic-embed-text (embeddings).

#! --- Configuration (module-level state) ---
var _base = "http://localhost:11434"
var _defaultModel = "qwen2.5:0.5b"
var _defaultEmbedModel = "nomic-embed-text"

#! --- client config (like openai.OpenAI(base_url=..., api_key=...)) ---
fun SetBase url
    _base is url

fun SetDefaultModel name
    _defaultModel is name

fun SetDefaultEmbedModel name
    _defaultEmbedModel is name

fun GetBase
    give _base

#! --- openai client.models.list() ---
fun Models
    var resp = http_get(_base + "/api/tags")
    var data = json_loads(resp["body"])
    var out dynamic = []
    repeat m in data["models"]
        out is out + [m["name"]]
    give out

#! --- openai client.chat.completions.create(model, messages) ---
#! messages = list of {"role":"user|assistant|system","content":"..."}
#! Returns the assistant reply text (openai: choices[0].message.content).
fun Chat model messages
    var payload = {"model": model, "messages": messages, "stream": false}
    var resp = http_post_json(_base + "/api/chat", payload)
    var data = json_loads(resp["body"])
    give data["message"]["content"]

#! --- openai client.completions.create(model, prompt) ---
#! Simple single-prompt completion; returns the generated text.
fun Ask model prompt
    var payload = {"model": model, "prompt": prompt, "stream": false}
    var resp = http_post_json(_base + "/api/generate", payload)
    var data = json_loads(resp["body"])
    give data["response"]

#! --- openai client.embeddings.create(model, input) ---
#! Single text → embedding vector (list of floats).
fun Embed model text
    var payload = {"model": model, "prompt": text}
    var resp = http_post_json(_base + "/api/embeddings", payload)
    var data = json_loads(resp["body"])
    give data["embedding"]

#! --- openai client.embeddings.create(model, input=[...]) ---
#! Batch: list of texts → list of embedding vectors.
fun EmbedMany model texts
    var payload = {"model": model, "input": texts}
    var resp = http_post_json(_base + "/api/embed", payload)
    var data = json_loads(resp["body"])
    give data["embeddings"]

#! --- cosine similarity between two embedding vectors ---
fun Similarity a b
    var dot = 0
    var i = 0
    repeat while i < len(a)
        dot is dot + a[i] * b[i]
        i is i + 1
    var magA = 0
    var magB = 0
    var j = 0
    repeat while j < len(a)
        magA is magA + a[j] * a[j]
        magB is magB + b[j] * b[j]
        j is j + 1
    var denom = math_sqrt(magA) * math_sqrt(magB)
    if denom == 0
        give 0
    give dot / denom

#! --- semantic search: rank docs (list of strings) by similarity to query ---
#! Returns list of [similarity, doc] sorted best-first.
fun Search query docs
    var q = Embed(_defaultEmbedModel, query)
    var scored dynamic = []
    repeat d in docs
        var v = Embed(_defaultEmbedModel, d)
        var sim = Similarity(q, v)
        scored is scored + [[sim, d]]
    give reverse(sort(scored))
