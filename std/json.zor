// json.zor — Simple JSON utilities for Zor
// Provides: stringify, parse (basic)

fun escape_string(s string) string {
    // Simple JSON string escaping
    var result string = "\""
    var i int = 0
    repeat while i < len(s) {
        var c int = s[i]
        if c == 34 { result is result + "\\\"" }
        or if c == 92 { result is result + "\\\\" }
        or if c == 10 { result is result + "\\n" }
        or if c == 13 { result is result + "\\r" }
        or if c == 9 { result is result + "\\t" }
        or { result is result + s[i] }
        i is i + 1
    }
    result is result + "\""
    give: result
}

fun object_start() string { give: "{" }
fun object_end() string { give: "}" }
fun array_start() string { give: "[" }
fun array_end() string { give: "]" }

fun pair(key string, value string) string {
    give: escape_string(key) + ": " + value
}

fun int_value(n int) string {
    // Simple int-to-string conversion
    if n == 0 { give: "0" }
    var result string = ""
    var neg int = 0
    if n < 0 { neg is 1; n is -n }
    repeat while n > 0 {
        var digit int = n % 10
        result is "" + digit + result
        n is n / 10
    }
    if neg == 1 { result is "-" + result }
    give: result
}

fun bool_value(b int) string {
    if b == 1 { give: "true" } or { give: "false" }
}

fun null_value() string { give: "null" }
