// net.zor — Networking stubs for Zor
// Provides: http_get, tcp_connect (stubs for now)

fun http_get(url string) string {
    // Stub: use curl via run_cmd
    var cmd string = "curl -s \"" + url + "\""
    run_cmd(cmd)
    give: ""
}

fun http_post(url string, body string) string {
    var cmd string = "curl -s -X POST -d '" + body + "' \"" + url + "\""
    run_cmd(cmd)
    give: ""
}

fun download(url string, path string) {
    var cmd string = "curl -s -o \"" + path + "\" \"" + url + "\""
    run_cmd(cmd)
}

fun tcp_connect(host string, port int) int {
    // Stub: raw socket support not yet available
    give: -1
}

fun tcp_send(fd int, data string) int {
    give: syscall(1, fd, data, len(data), 0, 0, 0)
}

fun tcp_recv(fd int, size int) string {
    // Allocate buffer and read
    give: ""
}

fun tcp_close(fd int) {
    syscall(3, fd, 0, 0, 0, 0, 0)
}
