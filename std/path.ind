#! path.ind
#! Path utilities for Indent

fun Basename path
    give path_basename path

fun Dirname path
    give path_dirname path

fun Join a b
    give path_join a b

fun Exists path
    give os_exists path

fun IsFile path
    give os_is_file path

fun IsDir path
    give os_is_dir path

fun Ext path
    give path_ext path

fun Stem path
    give path_stem path

fun Abs path
    give path_abs path

fun Expand path
    give path_expand path

fun Norm path
    give path_norm path
