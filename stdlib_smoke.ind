#! Aether-2 stdlib smoke test
get GetCwd from os
get Exists from os
get WriteText from os
get ReadText from os
get Loads from json
get Dumps from json
get RandInt from random
get Shuffle from random
get Pow from math
get Time from time

say GetCwd
WriteText "/tmp/aether_stdlib_file.txt" "hello"

var fileText string = ReadText "/tmp/aether_stdlib_file.txt"
var fileExists boolean = Exists "/tmp/aether_stdlib_file.txt"
say fileText
say fileExists

var powValue float = Pow 2.0 8.0
say powValue

var randomValue int = RandInt 1 10
say randomValue

var shuffled dynamic = Shuffle [1, 2, 3, 4]
say shuffled

var payload dynamic = Loads "{\"a\":1,\"b\":true}"
var dumped string = Dumps payload false
say payload["a"]
say dumped
say Time
