#! Regression test for async I/O: http_get_async etc. return a future; wait collects it.
#! Requires network access. Run: indent tests/async_io_builtins.ind

fun io_task
    var f = http_get_async "https://api.github.com/zen"
    wait f
    var r = __await_result__
    give r

#! single async GET
var f = http_get_async "https://api.github.com/zen"
wait f
var r = __await_result__
var t = type_of r
say "type=" + string(t)
assert_eq(t, "dict")
var hk = has_key r "ok"
assert(hk)

#! concurrent via gather
var f1 = http_get_async "https://api.github.com/zen"
var f2 = http_get_async "https://api.github.com/zen"
var res = gather f1 f2
var n = len res
assert_eq(n, 2)

#! cooperative via coop
var r2 = coop [["io_task", []]]
var first = r2[0]
var tf = type_of first
assert_eq(tf, "dict")

say "async io: ALL PASS"
