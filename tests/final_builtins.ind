#! final_builtins.ind — Indent 2.0 final additive builtins regression test
fun fail msg
    say "FAIL: " + msg
    process_exit 1

fun check_eq got expected
    var ok = got == expected
    if not ok
        var msg = "expected '" + expected + "' got '" + got + "'"
        fail msg

fun check cond
    if not cond
        fail "assertion failed"

#! ── os_which / os_run_ok ──────────────────────────────────────────
var sh = os_which "sh"
var shFound = not (sh == "")
check (shFound)

var okTrue = os_run_ok "true"
check (okTrue)
var okFalse = os_run_ok "false"
var falseIsFalse = not okFalse
check (falseIsFalse)

#! ── zip_longest ───────────────────────────────────────────────────
var zl = zip_longest [1,2] [3]
check_eq (string(zl)) "[[1, 3], [2, empty]]"
var zl2 = zip_longest [1,2] [3] "x"
check_eq (string(zl2)) "[[1, 3], [2, x]]"

#! ── pairwise ──────────────────────────────────────────────────────
var pw = pairwise [1,2,3]
check_eq (string(pw)) "[[1, 2], [2, 3]]"

#! ── filterfalse ───────────────────────────────────────────────────
var ff = filterfalse "is_even" [1,2,3,4]
check_eq (string(ff)) "[1, 3]"

#! ── compress ──────────────────────────────────────────────────────
var cp = compress [1,2,3,4] [TRUE,FALSE,TRUE,FALSE]
check_eq (string(cp)) "[1, 3]"

#! ── starmap ───────────────────────────────────────────────────────
var sm = starmap "add_int" [[1,2],[3,4],[10,20]]
check_eq (string(sm)) "[3, 7, 30]"

#! ── first / last ──────────────────────────────────────────────────
var fi = first [1,2,3,4] 2
check_eq (string(fi)) "[1, 2]"
var la = last [1,2,3,4] 2
check_eq (string(la)) "[3, 4]"

#! visible output
say "os_which(sh)=" + sh
say "zip_longest=" + string(zl2)
say "pairwise=" + string(pw)
say "starmap=" + string(sm)
say "first/last=" + string(fi) + " / " + string(la)
say "final builtins: ALL PASS"
