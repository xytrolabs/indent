#! Fixture for tests/module_classes.ind: a class that lives in a module.
class Point
    var x int = 0
    var y int = 0

    fun total
        give x + y

    fun moved dx dy
        give Point(x + dx, y + dy)

fun MakePoint a b
    give Point(a, b)

#! Deliberately exports `Bot` twice — as a class *and* as a namespace table, which is
#! the shape a real module ends up with. Classes are a separate namespace from
#! variables, so both have to survive the trip; collapsing them into one entry meant
#! whichever was folded last silently won.
class Bot
    var token string = ""
    var prefix string = ""

    fun describe
        give "bot(" + prefix + ")"

var Bot dynamic = {"kind": "bot-namespace", "version": 2}

#! Module state set through a module function has to be visible to the next one.
#! `mod.SetTag(...)` used to run in a throwaway runtime, so the write was discarded
#! and every later call saw the module's original value — which is how `ai.SetBase`
#! followed by `ai.Chat` ended up posting to an empty URL.
var _tag string = "unset"

fun SetTag t
    _tag is t
    give _tag

fun GetTag
    give _tag

