#! stdlib_breadth_builtins.ind — Indent 2.0 stdlib breadth regression test
#! Covers: itertools/functools/collections, math extras, random extras.

fun fail msg
    say "FAIL: " + msg
    process_exit 1

#! assert two string representations are equal
fun check_eq got expected
    var ok = got == expected
    if not ok
        fail "expected '" + expected + "' got '" + got + "'"

#! assert a boolean expression is TRUE
fun check cond
    if not cond
        fail "assertion failed"

#! ── itertools-style ───────────────────────────────────────────────
var ch = chain [1,2] [3,4] [5]
check_eq (string(ch)) "[1, 2, 3, 4, 5]"

var fl = flatten [[1,2],[3,[4,5]]]
check_eq (string(fl)) "[1, 2, 3, 4, 5]"

var ck = chunk [1,2,3,4,5,6,7] 3
check_eq (string(ck)) "[[1, 2, 3], [4, 5, 6], [7]]"

var pr = product [1,2] [3,4]
check_eq (string(pr)) "[[1, 3], [1, 4], [2, 3], [2, 4]]"

var pe = permutations [1,2]
check_eq (string(pe)) "[[1, 2], [2, 1]]"

var pe2 = permutations [1,2,3] 2
var pe2len = len pe2
check_eq (string(pe2len)) "6"

var co = combinations [1,2,3] 2
check_eq (string(co)) "[[1, 2], [1, 3], [2, 3]]"

var ac = accumulate [1,2,3,4]
check_eq (string(ac)) "[1, 3, 6, 10]"

var cy = cycle [1,2] 2
check_eq (string(cy)) "[1, 2, 1, 2]"

var rp = repeat_item "x" 3
check_eq (string(rp)) "[x, x, x]"

#! ── higher-order (predicate/key builtins) ─────────────────────────
var tw = takewhile "is_even" [2,4,6,7,8]
check_eq (string(tw)) "[2, 4, 6]"

var dw = dropwhile "is_even" [2,4,6,7,8]
check_eq (string(dw)) "[7, 8]"

var uq = unique [1,2,2,3,3,3]
check_eq (string(uq)) "[1, 2, 3]"

var pt = partition [1,2,3,4] "is_even"
check_eq (string(pt)) "[[2, 4], [1, 3]]"

var mx = max_key ["a","bb","ccc"] "len"
check_eq (string(mx)) "ccc"

var mn = min_key ["a","bb","ccc"] "len"
check_eq (string(mn)) "a"

var gb = group_by ["a","bb","c","ddd"] "len"
var gbHas = has_key gb "3"
check (gbHas)
var gb3 = dict_get gb "3"
check_eq (string(gb3)) "[ddd]"

#! ── functools-style ───────────────────────────────────────────────
var rd = reduce "add_int" [1,2,3,4]
check_eq (string(rd)) "10"

var rd2 = reduce "add_int" [1,2,3] 100
check_eq (string(rd2)) "106"

var rd3 = reduce "mul_int" [2,3,4]
check_eq (string(rd3)) "24"

#! ── math extras ───────────────────────────────────────────────────
var pi = math_pi
var piOk = pi > 3.14
check (piOk)
var e2 = math_e
var eOk = e2 > 2.7
check (eOk)

var fac = math_factorial 5
check_eq (string(fac)) "120"

var g = math_gcd 48 18
check_eq (string(g)) "6"

var gl = math_gcd [48, 18, 30]
check_eq (string(gl)) "6"

var lcm = math_lcm 4 6
check_eq (string(lcm)) "12"

var hyp = math_hypot 3 4
var hypOk = hyp == 5.0
check (hypOk)

var log2 = math_log2 8
var log2Ok = log2 == 3.0
check (log2Ok)

var deg = math_degrees 3.141592653589793
var degOk = deg > 179.9
check (degOk)

var rad = math_radians 180
var radOk = rad > 3.14
check (radOk)

#! ── random extras ─────────────────────────────────────────────────
random_seed 42
var ri = random_randint 1 6
var riOk = ri >= 1
check (riOk)
var riOk2 = ri <= 6
check (riOk2)

var ru = random_uniform 0 1
var ruOk = ru >= 0
check (ruOk)
var ruOk2 = ru < 1
check (ruOk2)

random_seed 7
var rs = random_sample [1,2,3,4,5] 3
var rsLen = len rs
check_eq (string(rsLen)) "3"

#! visible output
say "chain=" + string(ch)
say "product=" + string(pr)
say "accumulate=" + string(ac)
say "max_key=" + string(mx)
say "group_by=" + string(gb)
say "reduce sum=" + string(rd)
say "math_factorial(5)=" + string(fac)
say "math_gcd(48,18)=" + string(g)
say "stdlib breadth: ALL PASS"
